local Animator = require(script.Parent.Parent.Core.Animator)
local variables = require(script.Parent.Parent.Core.StateManager.variables)
local Icon = require(script.Parent.Icon)

local Page = {}
local S = Styles.Page
local H = S.hint

local function asset(id) return 'rbxassetid://' .. tostring(id) end

local ACTIVITY_INPUTS = {
	[Enum.UserInputType.MouseButton1] = true,
	[Enum.UserInputType.MouseButton2] = true,
	[Enum.UserInputType.Touch] = true,
	[Enum.UserInputType.MouseWheel] = true,
}

local function setHintShown(hint, shown)
	if hint.shown == shown then return end
	hint.shown = shown
	if hint.bob then hint.bob:Cancel() hint.bob = nil end
	Animator.play(hint.icon, if shown then H.tween.fadeIn else H.tween.fadeOut, {ImageTransparency = if shown then H.transparency else 1})
	if shown then
		hint.icon.Position = UDim2.new(0.5, 0, 0.5, -H.bob)
