	window.topContainer = renderer:Create('Frame', {Size = T.container.size, Position = T.container.position, AutomaticSize = Enum.AutomaticSize.Y, AnchorPoint = Vector2.new(0, 0.5), BackgroundTransparency = 1, Parent = window.topbar})
	window.topContainerLayout = renderer:Create('UIListLayout', {Padding = UDim.new(0, T.container.gap), FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, HorizontalAlignment = Enum.HorizontalAlignment.Left, SortOrder = Enum.SortOrder.LayoutOrder, Parent = window.topContainer})
	window.titleContainer = renderer:Create('Frame', {Size = T.titleBlock.size, Position = T.titleBlock.position, AutomaticSize = Enum.AutomaticSize.XY, AnchorPoint = Vector2.new(0, 0.5), BackgroundTransparency = 1, LayoutOrder = T.titleBlock.layoutOrder, Parent = window.topContainer})
