local colors = require(script.Parent.Parent.Core.Utilities.colors)
local locale = require(script.Parent.Parent.Core.Utilities.locale)

local WindowFrame = {}
local S = Styles.Window

local perCorner = (pcall(function()
	local corner = Instance.new('UICorner')
	corner.TopLeftRadius = UDim.new(0, 1)
	corner:Destroy()
end))

local function firstColor(value)
	return if typeof(value) == 'ColorSequence' then value.Keypoints[1].Value else value
end

local function frame(renderer, props)
	return renderer:Create('Frame', props)
end

function WindowFrame.roundCorners(renderer, parent, which)
	if not which or not perCorner then
		return renderer:Create('UICorner', {Parent = parent}, {CornerRadius = 'CornerRoundness'})
	end
	local props, themed = {Parent = parent}, {}
	for _, name in S.corners do props[name] = UDim.new(0, 0) end
	for _, name in which do
		props[name] = nil
		themed[name] = 'CornerRoundness'
	end
	return renderer:Create('UICorner', props, themed)
end

function WindowFrame.shell(renderer, window)
	window.screenGui = renderer:Create('ScreenGui', {Name = variables.httpService:GenerateGUID(false), IgnoreGuiInset = true, ResetOnSpawn = false, Enabled = true, DisplayOrder = Styles.Layers.displayOrder.window, ZIndexBehavior = Enum.ZIndexBehavior.Global, Parent = variables.guiContainer})
	window.main = renderer:Create('Frame', {BackgroundColor3 = S.white, Name = window.name, ZIndex = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.fromOffset(window.size.X.Offset - S.widthTrim, 0), BackgroundTransparency = 1, Visible = false, Parent = window.screenGui})
end

function WindowFrame.chrome(renderer, window)
