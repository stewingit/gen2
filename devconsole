end

local function fadeTopbar(shown, tween)
	reveal(W.title, {TextTransparency = if shown then 0 else 1}, tween, tween)
	for _, action in actions do
		if action.lit and shown then
			reveal(action.iconLabel, {ImageTransparency = Styles.Search.action.litTransparency}, tween, tween)
		else
			reveal(action.iconLabel, {ImageTransparency = if shown then Styles.Action.fade.rest else 1}, tween, tween)
		end
	end
	if shown then
		W.tabList.Visible = not searching
		consoleTab.topbarItem.Visible = true
		tabVisual(if searching then 'hidden' elseif W.selectedTab == consoleTab then 'selected' else 'unselected', tween)
		if searching then
			W.searchPill.Visible = true
			SearchBar.fade(W, true, tween)
		end
	else
		tabVisual('hidden', tween)
		if searching then SearchBar.fade(W, false, tween) end
	end
end

