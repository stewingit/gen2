local function spawnCFrame()
	local char = LocalPlayer and LocalPlayer.Character
	local hrp = char and char:FindFirstChild('HumanoidRootPart')
	if not hrp then
		window:Toast({title = 'No character found', subtitle = 'Respawn and try again', icon = 'x'})
		return nil
	end
	return hrp.CFrame * CFrame.new(0, 0, -5), char
end

local function contextFor(assetType)
	if assetType == 24 then
		return 'Play Animation', 'play', function()
			local cf, char = spawnCFrame()
			if not cf then return end
			if currentTrack then
				stopTrack()
				contextBtn:SetText('Play Animation')
				contextBtn:SetIcon('play')
				return
			end
			local humanoid = char:FindFirstChildOfClass('Humanoid')
			if not humanoid then
				window:Toast({title = 'No humanoid found', icon = 'x'})
				return
			end
			local animator = humanoid:FindFirstChildOfClass('Animator')
			if not animator then
				animator = Instance.new('Animator')
				animator.Parent = humanoid
			end
			local anim = Instance.new('Animation')
			anim.AnimationId = 'rbxassetid://' .. currentId
			local ok, loaded = pcall(function() return animator:LoadAnimation(anim) end)
			if not ok or not loaded then
				window:Toast({title = 'Could not load animation', subtitle = 'It may be restricted', icon = 'x'})
				return
			end
			loaded:Play()
			currentTrack = loaded
			contextBtn:SetText('Stop Animation')
			contextBtn:SetIcon('square')
		end
	elseif assetType == 2 or assetType == 11 or assetType == 12 then
		return 'Spawn Avatar Preview', 'user', function()
			local cf = spawnCFrame()
			if not cf then return end
			local desc = Instance.new('HumanoidDescription')
			if assetType == 2 then desc.GraphicTShirt = tonumber(currentId)
			elseif assetType == 11 then desc.Shirt = tonumber(currentId)
			else desc.Pants = tonumber(currentId) end
			local ok, dummy = pcall(function()
				return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
			end)
			if not ok or not dummy then
				window:Toast({title = 'Failed to load preview', icon = 'x'})
				return
			end
			for _, part in dummy:GetDescendants() do
				if part:IsA('BasePart') then part.Color = Color3.fromRGB(163, 162, 165) end
			end
			dummy:PivotTo(cf * CFrame.Angles(0, math.pi, 0))
			dummy.Parent = workspace
			track(dummy)
			window:Toast({title = 'Spawned avatar preview', icon = 'check'})
		end
	elseif assetType == 1 then
		return 'Spawn Preview Part', 'image', function()
			local cf = spawnCFrame()
			if not cf then return end
			local part = Instance.new('Part')
			part.Size = Vector3.new(4, 4, 1)
			part.CFrame = cf
			part.Anchored = true
			part.CanCollide = false
			part.Parent = workspace
			local decal = Instance.new('Decal')
			decal.Face = Enum.NormalId.Front
			decal.Texture = 'rbxassetid://' .. currentId
			decal.Parent = part
			track(part)
			window:Toast({title = 'Spawned preview part', icon = 'check'})
		end
	elseif ModelTypes[assetType] then
		return 'Spawn Model', 'box', function()
			local cf = spawnCFrame()
			if not cf then return end
			local ok, objects = pcall(function() return game:GetObjects('rbxassetid://' .. currentId) end)
			if not ok or not objects then
				window:Toast({title = 'Failed / restricted', subtitle = 'This asset cannot be loaded', icon = 'x'})
				return
			end
			for _, object in objects do
				if object:IsA('Model') then
					object:MoveTo(cf.Position)
				elseif object:IsA('BasePart') then
					object.CFrame = cf
				end
				object.Parent = workspace
				track(object)
			end
			window:Toast({title = 'Spawned model', icon = 'check'})
		end
	end
	return nil
end

function W:Search()
	local query = self.searchInput.Text
	if query == '' then return end

	searchToken += 1
	local token = searchToken

	self:StopMedia()
	stopTrack()
	mediaKind = nil
	contextAction = nil
	setMediaControls(false)
	setContext(nil)
	preview.video.Visible = false
	preview.image.Visible = true
	preview.image.ImageTransparency = 1
	preview.empty.Visible = true
	info:SetTitle('Status')
	info:Set('Searching...')
	setBusy(true, 'Searching...')

	task.spawn(function()
		local data = registry.search(query)
		if token ~= searchToken or window.unloaded then return end

		if not data.Success then
			info:SetTitle('Status')
			info:Set(esc(data.Status))
			currentId, currentInfo = '', nil
			saveBtn:SetText('Download')
			setTag(nil)
			setBusy(false)
			return
		end

		local assetInfo = data.Info
		currentId = tostring(assetInfo.Id)
		currentInfo = assetInfo
		local assetType = assetInfo.AssetType
		local typeName = AssetTypes[assetType] or 'Asset'

		info:SetTitle(esc(assetInfo.Name))
		info:Set(string.format('<b>Type</b>  %s\n<b>Creator</b>  %s\n<b>ID</b>  %s', esc(assetInfo.TypeName), esc(assetInfo.Creator), currentId))
		saveBtn:SetText('Download ' .. typeName)
		setTag(typeName)

		renderer.assign(preview.image, 'Image', 'rbxthumb://type=Asset&id=' .. currentId .. '&w=420&h=420')
		pcall(function() ContentProvider:PreloadAsync({preview.image}) end)
		if token ~= searchToken or window.unloaded then return end
		preview.empty.Visible = false
		Animator.play(preview.image, Animator.presets.Quint_0_4, {ImageTransparency = 0})

		if assetType == 3 then
			mediaKind = 'audio'
			audio.SoundId = 'rbxassetid://' .. currentId
			setMediaControls(true)
		elseif assetType == 62 then
			mediaKind = 'video'
			preview.video.Video = 'rbxassetid://' .. currentId
			preview.video.Visible = true
			preview.image.Visible = false
			setMediaControls(true)
			task.spawn(function()
				local started = os.clock()
				repeat task.wait() until preview.video.Resolution ~= Vector2.zero or os.clock() - started > 10 or token ~= searchToken
				if preview.video.Resolution.Y > 0 then
					videoAspect.AspectRatio = preview.video.Resolution.X / preview.video.Resolution.Y
				end
			end)
		else
			local label, icon, action = contextFor(assetType)
			if label then
				contextAction = action
				setContext(label, icon)
			end
		end
		setBusy(false)
	end)
end

local function safeName(name)
	local cleaned = (tostring(name):gsub('[^%w%s]', ''))
	if cleaned == '' then cleaned = 'asset' end
	return cleaned
end

local function ensureFolder()
	pcall(function()
		if not (isfolder and makefolder) then return end
		for _, folder in {SAVE_FOLDER, DOWNLOAD_FOLDER, LOAD_FOLDER} do
			if not isfolder(folder) then makefolder(folder) end
		end
	end)
end
ensureFolder()

local function downloadAsImage()
	if not currentInfo then return end
	local id, name = currentId, currentInfo.Name
	setBusy(true, 'Downloading image...')
	task.spawn(function()
		ensureFolder()
		local thumbData
		local url = 'https://thumbnails.roblox.com/v1/assets?assetIds=' .. id .. '&returnPolicy=PlaceHolder&size=420x420&format=Png&isCircular=false'
		local ok, response = pcall(function() return game:HttpGet(url) end)
		if ok and response then
			local decodeOk, decoded = pcall(function() return HttpService:JSONDecode(response) end)
			local imageUrl = decodeOk and decoded and decoded.data and decoded.data[1] and decoded.data[1].imageUrl
			if imageUrl then
				local imgOk, imgData = pcall(function() return game:HttpGet(imageUrl) end)
				if imgOk then thumbData = imgData end
			end
		end
		setBusy(false)
		if thumbData and #thumbData > 100 then
			local path = string.format('%s/%s_%s.png', DOWNLOAD_FOLDER, safeName(name), id)
			local wrote = pcall(writefile, path, thumbData)
			if wrote then
				window:Toast({title = 'Saved to files', subtitle = path, icon = 'check'})
				return
			end
		end
		window:Toast({title = 'Download failed', subtitle = 'Could not save the image', icon = 'x'})
	end)
end

function W:Download()
	if currentId == '' or not currentInfo then
		window:Toast({title = 'Nothing to download', subtitle = 'Search for an asset first', icon = 'x'})
		return
	end
	if not writefile then
		window:Toast({title = 'No writefile support', subtitle = 'Your executor cannot save files', icon = 'x'})
		return
	end

	local assetType = currentInfo.AssetType
	if assetType == 1 then
		downloadAsImage()
		return
	end

	local id, name = currentId, currentInfo.Name
	setBusy(true, 'Downloading...')
	task.spawn(function()
		ensureFolder()
		local ext = ExtensionMap[assetType] or ExtensionMap.Default
		local ok, res = pcall(function() return game:HttpGet('https://assetdelivery.roblox.com/v1/asset/?id=' .. id) end)
		setBusy(false)
		if ok and type(res) == 'string' and #res > 500 then
			local path = string.format('%s/%s_%s%s', DOWNLOAD_FOLDER, safeName(name), id, ext)
			local wrote = pcall(writefile, path, res)
			if wrote then
				window:Toast({title = 'Saved to files', subtitle = path, icon = 'check'})
			else
				window:Toast({title = 'Download failed', subtitle = 'Could not write the file', icon = 'x'})
			end
			return
		end
		window:Popup({
			title = 'Download denied',
			subtitle = 'The raw asset could not be fetched',
			content = 'This asset is probably private or protected. You can save its thumbnail image instead.',
			icon = 'download',
			options = {
				{text = 'Cancel'},
				{text = 'Download image', style = 'primary', callback = downloadAsImage},
			},
		})
	end)
end

