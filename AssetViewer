local function reveal(instance, goals, animate, info)
	if not instance then return end
	if animate then
		Animator.play(instance, if typeof(info) == 'TweenInfo' then info else Animator.presets.Expo_0_4, goals)
	else
		for property, value in goals do instance[property] = value end
	end
end

function W:_revealCommon(el, animate)
	local theme = self.theme
	reveal(el.stroke, {Transparency = theme.ElementStrokeTransparency}, animate)
	reveal(el.title, {TextTransparency = 0}, animate)
	reveal(el.main, {BackgroundTransparency = theme.ElementTransparency or 0}, animate)
	if el.iconLabel then reveal(el.iconLabel, {ImageTransparency = 0}, animate) end
	if el.descriptor then reveal(el.descriptor.titleLabel, {TextTransparency = 0.7}, animate) end
end

function W:_hideCommon(el, animate)
	reveal(el.stroke, {Transparency = 1}, animate)
	reveal(el.title, {TextTransparency = 1}, animate)
	reveal(el.main, {BackgroundTransparency = 1}, animate)
	if el.iconLabel then reveal(el.iconLabel, {ImageTransparency = 1}, animate) end
	if el.descriptor then reveal(el.descriptor.titleLabel, {TextTransparency = 1}, animate) end
end

function W:_fadeSurfaces(shown, info)
	local goals = {
		[self.windowShadow] = {Transparency = if shown then 0.6 else 1},
		[self.windowStroke] = {Transparency = if shown then 0.95 else 1},
		[self.bottomFade] = {BackgroundTransparency = if shown then 0 else 1},
	}
	for instance, props in goals do
		if info then
			Animator.play(instance, info, props)
		else
			for property, value in props do instance[property] = value end
		end
	end
end

