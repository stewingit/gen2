local function fitSize()
	local cam = workspace.CurrentCamera
	local viewport = cam and cam.ViewportSize
	local base = windowSizing.fit(viewport, 'top')
	if not viewport or viewport.Y < 200 then return base end
	local height = math.min(base.Y.Offset + 90 + CHROME_EXTRA, math.floor(viewport.Y * 0.92) - 20)
	return UDim2.fromOffset(base.X.Offset, math.max(height, base.Y.Offset))
end
