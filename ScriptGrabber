		input = {placeholder = 'Name...', limit = CONFIG.MaxFolderName},
		options = {
			{text = 'Cancel'},
			{text = 'Confirm', style = 'primary', callback = function(text)
				local name = cleanFolderName(text or '')
				if name == '' then name = nextFolderName() end
				openProject(name)
			end},
		},
	}
end

local function openDelete(kind, targetName)
	mainW:Popup{
		title = 'Delete ' .. string.lower(kind) .. '?',
		content = targetName .. ' will be permanently deleted.',
		icon = ICON.Trash,
		options = {
			{text = 'Cancel'},
			{text = 'Delete', style = 'danger', callback = function()
				pcall(function()
					if kind == 'Folder' then delfolder(ROOT .. '/' .. targetName)
					else delfile(projectName .. '/' .. targetName) end
				end)
				currentFilePath = ''
				refreshCurrent()
			end},
		},
	}
end

local function renameTarget(kind, targetName, text)
	if kind == 'Folder' then
		local newName = cleanFolderName(text)
		if newName == '' or newName == targetName then return end
		local oldPath, newPath = ROOT .. '/' .. targetName, ROOT .. '/' .. newName
		if isfolder(newPath) then
			notice('Name already used', 'A folder called ' .. newName .. ' already exists.')
			return
		end
		pcall(function()
			makefolder(newPath)
			for _, file in listfiles(oldPath) do
				writefile(newPath .. '/' .. basename(file), readfile(file))
			end
			delfolder(oldPath)
		end)
	else
		local newName = cleanFileName(text)
		local current = (targetName:gsub('%.txt$', ''))
		if newName == '' or newName == current then return end
		pcall(function()
			writefile(projectName .. '/' .. newName .. '.txt', readfile(projectName .. '/' .. targetName))
			delfile(projectName .. '/' .. targetName)
		end)
	end
	currentFilePath = ''
	refreshCurrent()
end

local function openEdit(kind, targetName)
	local isFolder = kind == 'Folder'
	local shown = if isFolder then targetName else (targetName:gsub('%.txt$', ''))
	mainW:Popup{
		title = 'Rename ' .. string.lower(kind),
		icon = ICON.Edit,
		input = {text = shown, placeholder = 'Name...', limit = if isFolder then CONFIG.MaxFolderName else CONFIG.MaxFileName},
		options = {
			{text = 'Cancel'},
			{text = 'Delete', style = 'danger', callback = function() openDelete(kind, targetName) end},
			{text = 'Rename', style = 'primary', callback = function(text) renameTarget(kind, targetName, text or '') end},
		},
	}
end

local function highlight(source)
	source = source:gsub('&', '&amp;'):gsub('<', '&lt;'):gsub('>', '&gt;')
	source = source:gsub('%-%-[^\n]*', '<font color="rgb(90, 100, 115)">%0</font>')
	return source
end

local function loadFileContent(filePath)
	if not viewerCode then return end
	if not isfile(filePath) then
		viewerCode.setText('ERROR: FILE NOT FOUND', '1', false)
		return
	end
	if currentFilePath ~= filePath then
		local ok, content = pcall(readfile, filePath)
		if not ok or content == '' then content = '-- No content or read error --' end
		currentFullContent = content
		if #content > CONFIG.ViewLimit then
			local folderPart = filePath:match(ROOT .. '/([^/]+)') or 'UnknownFolder'
			local filePart = filePath:match('([^/]+)$') or 'UnknownFile'
			content = content:sub(1, CONFIG.ViewLimit)
				.. '\n\n-- Text limit reached\n-- View the full script in your workspace files:\n-- '
				.. ROOT .. '/' .. folderPart .. '/' .. filePart
		end
		currentRawContent = content
		currentFilePath = filePath
	end

	local lineCount = select(2, currentRawContent:gsub('\n', '')) + 1
	local numbers = table.create(lineCount)
	for index = 1, lineCount do numbers[index] = tostring(index) end

	local rich = highlight(currentRawContent)
	if #rich > 16000 then
		viewerCode.setText(currentRawContent, table.concat(numbers, '\n'), false)
	else
		viewerCode.setText(rich, table.concat(numbers, '\n'), true)
	end
end

local function buildViewer()
	local cfg = CONFIG.Viewer
	local win = Window.new{
		name = 'File Viewer',
		subtitle = 'Captured script',
		icon = ICON.Viewer,
		width = cfg.Width,
		height = cfg.Height,
		onClose = function() if viewerW then viewerW:Hide() end end,
	}
	local renderer = win.renderer
	local page = win.page

	local copyBtn
	copyBtn = win:CreateButton(page, {
		name = 'Copy All', icon = ICON.Copy, order = 1,
		callback = function()
			if setclipboard and currentFullContent ~= '' then
				setclipboard(currentFullContent)
				local old = copyBtn.title.Text
				copyBtn.title.Text = 'Copied!'
				task.wait(1.5)
				if not win.unloaded then copyBtn.title.Text = old end
			end
		end,
	})

	local cardHeight = (cfg.Height - win.layout.chromeHeight) - PS.padTop - PS.padBottom - 43 - PS.gap
	local card = {window = win, connections = {}}
	card.main = renderer:Create('Frame', {Name = 'Code', Size = UDim2.new(1, -20, 0, cardHeight), BackgroundTransparency = 1, BorderSizePixel = 0, ClipsDescendants = true, LayoutOrder = 2, Parent = page}, {BackgroundColor3 = 'StatBackground'})
	renderer:Create('UICorner', {Parent = card.main}, {CornerRadius = 'ElementCornerRadius'})
	card.stroke = renderer:Create('UIStroke', {ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = 1, Parent = card.main}, {Color = 'SurfaceStroke'})
	local scroll = renderer:Create('ScrollingFrame', {
		Size = UDim2.new(1, -12, 1, -12), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundTransparency = 1, BorderSizePixel = 0, AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(0, 0, 0, 0), ScrollBarThickness = 4, ScrollBarImageTransparency = 0.7,
		ScrollingDirection = Enum.ScrollingDirection.Y, Parent = card.main,
	})
	local inner = renderer:Create('Frame', {Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, BorderSizePixel = 0, Parent = scroll})
	renderer:Create('UIListLayout', {FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = inner})

	local codeFont, codeSize, lineHeight = Styles.Console.line.font, Styles.Console.line.textSize, Styles.Console.line.lineHeight
	local numbers = renderer:Create('TextLabel', {
		Size = UDim2.new(0, 36, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, BorderSizePixel = 0,
		FontFace = codeFont, TextSize = codeSize, LineHeight = lineHeight, Text = '1', LayoutOrder = 1,
		TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Top, TextTransparency = 1, Parent = inner,
	}, {TextColor3 = 'ContentColor'})
	local code = renderer:Create('TextLabel', {
		Size = UDim2.new(1, -48, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, BorderSizePixel = 0,
		FontFace = codeFont, TextSize = codeSize, LineHeight = lineHeight, Text = '', LayoutOrder = 2, RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, TextTransparency = 1, Parent = inner,
	}, {TextColor3 = 'ContentColor'})

	function card._setShown(_, shown, animate)
		win:_reveal(card.main, {BackgroundTransparency = if shown then 0 else 1}, animate)
		win:_reveal(card.stroke, {Transparency = if shown then 0.9 else 1}, animate)
		win:_reveal(numbers, {TextTransparency = if shown then 0.55 else 1}, animate)
		win:_reveal(code, {TextTransparency = if shown then 0.1 else 1}, animate)
	end
	win:_add(card)

	viewerCode = {
		setText = function(text, lineText, rich)
			code.RichText = rich
			code.Text = text
			numbers.Text = lineText
			scroll.CanvasPosition = Vector2.zero
		end,
	}
	return win
end

local function openViewer(filePath, fileName)
	if not viewerW or viewerW.unloaded then viewerW = buildViewer() end
	viewerW:SetTitle('VIEWING: ' .. fileName)
	loadFileContent(filePath)
	viewerW:Show()
end

local function setBackVisible(visible)
	if view == 'folder' and backBtn and backBtn.main then backBtn.main.Visible = visible end
end

local function setStatus(text, color)
	if mainW.unloaded or view ~= 'folder' or not progress then return end
	progress.title.Text = text
	progress.title.TextColor3 = color or mainW.theme.ContentColor
end

local function setBar(ratio)
	if mainW.unloaded or view ~= 'folder' or not progress then return end
	progress:Set(ratio)
end

function refreshFolders(filter)
	if view ~= 'menu' then return end
	clearRows()
	local ok, folders = pcall(listfiles, ROOT)
	if not ok then return end
	table.sort(folders, function(a, b) return basename(a):lower() < basename(b):lower() end)

	local needle = string.lower(filter or '')
	for index, path in folders do
		local name = basename(path)
		if isfolder(path) and (needle == '' or string.find(name:lower(), needle, 1, true)) then
			local count = 0
			pcall(function() count = #listfiles(path) end)
			table.insert(rowObjs, mainW:CreateRow(mainW.page, {
				name = name .. ' (' .. count .. ')',
				icon = ICON.Folder,
				editIcon = ICON.Edit,
				order = 100 + index,
				onOpen = function() openProject(name) end,
				onEdit = function() openEdit('Folder', name) end,
			}))
		end
	end
end

function refreshFiles()
	if view ~= 'folder' then return end
	clearRows()
	local ok, files = pcall(listfiles, projectName)
	if not ok then return end
	table.sort(files, function(a, b)
		local aNum = tonumber(basename(a):match('^(%d+)_')) or 0
		local bNum = tonumber(basename(b):match('^(%d+)_')) or 0
		return aNum < bNum
	end)
	for index, file in files do
		local fileName = basename(file)
		table.insert(rowObjs, mainW:CreateRow(mainW.page, {
			name = fileName,
			icon = ICON.File,
			editIcon = ICON.Edit,
			order = 100 + index,
			onOpen = function() openViewer(projectName .. '/' .. fileName, fileName) end,
			onEdit = function() openEdit('File', fileName) end,
		}))
	end
end

function showMenu()
	view = 'menu'
	clearRows()
	clearStatic()
	searchEl = mainW:CreateInput(mainW.page, {
		name = 'Search', icon = Styles.Icons.search, placeholder = 'Folders...', order = 1,
		onChanged = function(text) refreshFolders(text) end,
	})
	local createBtn = mainW:CreateButton(mainW.page, {
		name = 'Create New Folder', icon = ICON.NewFolder, order = 2, callback = openCreatePopup,
	})
	staticEls = {searchEl, createBtn}
	refreshFolders('')
end

function showFolder()
	view = 'folder'
	clearRows()
	clearStatic()
	progress = mainW:CreateProgress(mainW.page, {name = 'LISTENING: ' .. basename(projectName), icon = ICON.Listen, order = 1})
	backBtn = mainW:CreateButton(mainW.page, {
		name = 'Back To Menu', icon = ICON.Back, order = 2,
		callback = function()
			is_initialized, projectName, global_index = false, '', 0
			showMenu()
		end,
	})
	backBtn.main.Visible = activeTasks == 0
	staticEls = {progress, backBtn}
	refreshFiles()
end

local function AutoCapture(code, chunk)
	if app.destroyed or mainW.unloaded then return end
	if not is_initialized then
		local folderName = nextFolderName()
		projectName = ROOT .. '/' .. folderName
		pcall(makefolder, projectName)
		global_index = 0
		is_initialized = true
		showFolder()
	end

	activeTasks += 1
	global_index += 1
	setBackVisible(false)

	local rawName = (chunk and tostring(chunk):gsub('[^%w%s]', ''):sub(1, 20)) or 'script'
	if rawName == '' then rawName = 'script' end
	local finalFileName = global_index .. '_' .. rawName .. '.txt'
	local targetPath = projectName

	if view == 'folder' and progress then
		local gradient = progress.fill and progress.fill:FindFirstChildOfClass('UIGradient')
		if gradient then gradient.Color = ColorSequence.new(Color3.fromHSV(math.random(), 0.7, 1)) end
	end

	task.spawn(function()
		local texts = {'EXTRACTING', 'GRABBING', 'DUMPING', 'CACHING', 'SNAGGING', 'VIEWING', 'YOINKING'}
		local selectedText = texts[math.random(1, #texts)]

		for i = 1, 4 do
			if activeTasks > 0 then
				setStatus(selectedText .. ' (' .. rawName .. ')...', Color3.fromRGB(200, 200, 255))
				setBar(i / 4)
				task.wait(0.4)
			end
		end

		pcall(writefile, targetPath .. '/' .. finalFileName, code)
		activeTasks -= 1

		if activeTasks == 0 then
			task.wait(0.8)
			if activeTasks == 0 and not mainW.unloaded then
				setStatus('Finished!', Color3.fromRGB(0, 255, 150))
				setBackVisible(true)
				if view == 'folder' and projectName == targetPath then refreshFiles() end
				setBar(0)
				task.wait(1.5)
				if activeTasks == 0 then setStatus('LISTENING: ' .. basename(projectName)) end
			end
		end
	end)
end

local hookState = registry.ScriptGrabberHook

local function destroyAll()
	if app.destroyed then return end
	app.destroyed = true
	if hookState then hookState.capture = nil end
	if viewerW then viewerW:Unload() end
	if mainW then mainW:Unload() end
	registry.ScriptGrabber = nil
end

local function confirmDestroy()
	mainW:Popup{
		title = 'Destroy Script Grabber?',
		content = 'This closes the grabber and stops capturing scripts. Everything already saved stays in your workspace folder.',
		icon = ICON.Trash,
		options = {
			{text = 'Cancel'},
			{text = 'Destroy', style = 'danger', callback = destroyAll},
		},
	}
end

local started, startErr = xpcall(function()
	mainW = Window.new{
		name = 'Script Grabber',
		subtitle = 'loadstring capture',
		icon = ICON.App,
		width = CONFIG.Grabber.Width,
		height = CONFIG.Grabber.Height,
		onClose = confirmDestroy,
	}
	registry.ScriptGrabber = {Destroy = destroyAll}
	showMenu()
	mainW:Show()
end, debug.traceback)

if not started then
	pcall(destroyAll)
	error('Script Grabber failed to start:\n' .. tostring(startErr), 0)
end

if not hookState then
	hookState = {}
	registry.ScriptGrabberHook = hookState
	local old
	old = hookfunction(loadstring, function(code, chunk)
		local capture = hookState.capture
		if capture and type(code) == 'string' then task.spawn(capture, code, chunk) end
		return old(code, chunk)
	end)
end
hookState.capture = AutoCapture
