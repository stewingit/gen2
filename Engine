	local hint = {holder = holder, icon = icon, shown = false, tab = nil, lastY = 0, idleSince = os.clock()}

	local function markActive()
		hint.idleSince = os.clock()
		setHintShown(hint, false)
	end

	renderer:Connect(variables.userInputService.InputBegan, function(input)
		if ACTIVITY_INPUTS[input.UserInputType] then markActive() end
	end)
	renderer:Connect(variables.userInputService.InputChanged, function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then markActive() end
	end)

	renderer:Connect(variables.runService.RenderStepped, function()
		if not holder.Parent then return end
		local now = os.clock()
		local tab = window.selectedTab
		local page = tab and tab.tabPage
		local interactive = if window._interactive then window:_interactive() else true
		if not page or not page.Parent or window.unloaded or window.hidden or window.minimised or window._searching or not interactive then
			hint.tab = nil
			hint.idleSince = now
			setHintShown(hint, false)
			return
		end
		local y = page.CanvasPosition.Y
		if hint.tab ~= tab then
			-- switching tabs counts as activity
			hint.tab = tab
			hint.lastY = y
			markActive()
			return
		end
		if math.abs(y - hint.lastY) > 0.5 then
			-- the user (or a dropdown) scrolled this tab: don't nag about it again
			hint.lastY = y
			tab._scrollHintDismissed = true
			markActive()
			return
		end
		local remaining = page.AbsoluteCanvasSize.Y - (y + page.AbsoluteWindowSize.Y)
		local overflows = page.AbsoluteWindowSize.Y > 0 and page.AbsoluteCanvasSize.Y - page.AbsoluteWindowSize.Y > H.minOverflow
		local wanted = overflows and remaining > H.minOverflow and not tab._scrollHintDismissed and (now - hint.idleSince) >= H.delay
