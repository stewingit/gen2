CollapsedFace.build(renderer, W)
do
	local collapsedPressed, collapsedMoved, grabOffset, startMouse = false, false, Vector2.zero, Vector2.zero
	local dragThreshold = Styles.Collapsed.dragThreshold
	local function inset()
		if W.screenGui and W.screenGui.IgnoreGuiInset then return variables.guiService:GetGuiInset() end
		return Vector2.zero
	end
	renderer:Connect(W.collapsedInteract.InputBegan, function(input, processed)
		if processed or not W.hidden or W.animating then return end
		local kind = input.UserInputType.Name
		if kind ~= 'MouseButton1' and kind ~= 'Touch' then return end
		collapsedPressed, collapsedMoved = true, false
		startMouse = UserInputService:GetMouseLocation()
		grabOffset = W.main.AbsolutePosition + W.main.AbsoluteSize * W.main.AnchorPoint - startMouse
	end)
	renderer:Connect(UserInputService.InputEnded, function(input)
		local kind = input.UserInputType.Name
		if kind ~= 'MouseButton1' and kind ~= 'Touch' then return end
		if not collapsedPressed then return end
		collapsedPressed = false
		if collapsedMoved then
			W._collapsedPosition = W.main.Position
			return
		end
		W.ToggleHide()
	end)
	renderer:Connect(UserInputService.WindowFocusReleased, function() collapsedPressed = false end)
	renderer:Connect(variables.runService.RenderStepped, function()
		if not collapsedPressed then return end
		if not W.hidden or W.animating then collapsedPressed = false return end
		local mouse = UserInputService:GetMouseLocation()
		if not collapsedMoved and (mouse - startMouse).Magnitude < dragThreshold then return end
		collapsedMoved = true
		local target = mouse + grabOffset + inset()
		W.main.Position = UDim2.fromOffset(target.X, target.Y)
	end)
end

do
	local DS = Styles.DragBar
	local dragging, grabOffset = false, Vector2.zero
	local inset = Vector2.zero
	if W.screenGui.IgnoreGuiInset then inset = variables.guiService:GetGuiInset() end

	local function targets()
		local mouse = UserInputService:GetMouseLocation() + grabOffset + inset
		local x, y = mouse.X, mouse.Y
		local main, screen, margin = W.main.AbsoluteSize, W.screenGui.AbsoluteSize, DS.screenMargin
		local halfX, halfY = main.X / 2, main.Y / 2
		x = math.clamp(x, halfX + margin, math.max(halfX + margin, screen.X - halfX - margin))
		y = math.clamp(y, halfY + margin, math.max(halfY + margin, screen.Y - halfY - margin))
		return UDim2.fromOffset(x, y), UDim2.fromOffset(x, y + (W.main.Size.Y.Offset / 2 + DS.gap))
	end

	local function interactive() return not W.animating and not W.hidden end

	renderer:Connect(dragBar.drag.MouseEnter, function()
		if not dragging and not W.hidden then DragBar.hover(dragBar, true) end
	end)
	renderer:Connect(dragBar.drag.MouseLeave, function()
		if not dragging and not W.hidden then DragBar.hover(dragBar, false) end
	end)

	local function release()
		if not dragging then return end
		dragging = false
		if not interactive() then return end
		local mainPosition, barPosition = targets()
		DragBar.release(dragBar, mainPosition, barPosition)
	end

	renderer:Connect(dragBar.dragInteract.InputBegan, function(input, processed)
		if processed then return end
		local kind = input.UserInputType.Name
		if kind ~= 'MouseButton1' and kind ~= 'Touch' then return end
		if not interactive() then return end
		dragging = true
		if W.screenGui.IgnoreGuiInset then inset = variables.guiService:GetGuiInset() end
		grabOffset = W.main.AbsolutePosition + W.main.AbsoluteSize * W.main.AnchorPoint - UserInputService:GetMouseLocation()
		DragBar.press(dragBar)
	end)
	renderer:Connect(UserInputService.InputEnded, function(input)
		local kind = input.UserInputType.Name
		if kind == 'MouseButton1' or kind == 'Touch' then release() end
	end)
	renderer:Connect(UserInputService.WindowFocusReleased, release)
	renderer:Connect(variables.runService.RenderStepped, function(dt)
		if not dragging then return end
		if not interactive() then release() return end
		local mainTarget, barTarget = targets()
		DragBar.follow(dragBar, mainTarget, barTarget, dt)
	end)
end

