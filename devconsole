local function applyFilters(text)
	local processed = text
	if filterUsername and LocalPlayer then
		processed = string.gsub(processed, LocalPlayer.Name, 'game:GetService("Players").LocalPlayer.Name')
	end
	return processed
end

local function searchText()
	return string.lower(W.searchInput.Text or '')
end

local function updateLogs()
	local query = searchText()
	local anyVisible = false
	for _, data in pairs(logs) do
		local text = showTimestamp and (data.time .. data.msg) or data.msg
		local filteredText = applyFilters(text)
		data.label.Text = filteredText
		local match = (query == '' or string.find(string.lower(filteredText), query, 1, true) ~= nil)
		data.label.Visible = match
		anyVisible = anyVisible or match
	end
	W.searchEmpty.Visible = (not anyVisible) and query ~= ''
end

local function getFormattedPath(instance)
	local parts = {}
	local current = instance
	while current and current ~= game do
		table.insert(parts, 1, current.Name)
		current = current.Parent
	end
	return table.concat(parts, '.')
end

local function serializeTable(val, indent)
	indent = indent or 1
	local tabs = string.rep('\t', indent)
	local prevTabs = string.rep('\t', indent - 1)
	if type(val) == 'table' then
		local res = '{\n'
		local keys = {}
		for k in pairs(val) do table.insert(keys, k) end
		for i, k in ipairs(keys) do
			local keyStr = (type(k) == 'string') and k .. ' = ' or (type(k) == 'number' and k ~= i and '[' .. tostring(k) .. '] = ' or '')
			res = res .. tabs .. keyStr .. serializeTable(val[k], indent + 1) .. (i == #keys and '' or ',') .. '\n'
		end
		return res .. prevTabs .. '}'
	elseif type(val) == 'string' then
		return '"' .. val .. '"'
	elseif typeof(val) == 'Instance' then
		return 'game.' .. val:GetFullName()
	else
		return tostring(val)
	end
end

local function copyText(text)
	local clip = (getgenv and getgenv().setclipboard) or setclipboard
	if clip then
		clip(text)
		return true
	end
	return false
end

local function flashCopied(label, defaultColor)
	local token = (label:GetAttribute('flash') or 0) + 1
	label:SetAttribute('flash', token)
	Animator.play(label, presets.Quint_0_1, {TextColor3 = COPY_GREEN_STROKE, BackgroundColor3 = COPY_GREEN, BackgroundTransparency = 0.55})
	task.delay(0.22, function()
		if label:GetAttribute('flash') ~= token or not label.Parent then return end
		Animator.play(label, presets.Quint_0_45, {TextColor3 = defaultColor, BackgroundTransparency = 1})
	end)
end

local function addLog(message, messageType)
	if not alive then return end
	local timestamp = '[' .. os.date('%X') .. '] '
	local cleanMsg = tostring(message)
	local wasAtBottom = atBottom()

	local label = LogView.makeLine(renderer, console)
	label.BackgroundColor3 = COPY_GREEN
	label.BackgroundTransparency = 1
	renderer:Create('UICorner', {CornerRadius = UDim.new(0, 4), Parent = label})

	local defaultColor = Color3.fromRGB(220, 220, 225)
	if messageType == 'REMOTE' then
		defaultColor = Color3.fromRGB(52, 152, 219)
	elseif messageType == 'PROXIMITY' then
		defaultColor = Color3.fromRGB(230, 126, 34)
	elseif messageType == 'UICLICK' then
		defaultColor = Color3.fromRGB(155, 89, 182)
	elseif messageType == 'TOUCH' then
		defaultColor = Color3.fromRGB(26, 188, 156)
	elseif messageType == 'CLICKDETECTOR' then
		defaultColor = Color3.fromRGB(255, 118, 117)
	elseif messageType == 'SELECT' then
		defaultColor = Color3.fromRGB(241, 196, 15)
	elseif messageType == 'SYSTEM' then
		defaultColor = Colors.Success
	elseif messageType == Enum.MessageType.MessageError then
		defaultColor = Colors.Danger
	elseif messageType == Enum.MessageType.MessageWarning then
		defaultColor = Color3.fromRGB(241, 196, 15)
	end

	label.TextColor3 = defaultColor
	local finalMsg = showTimestamp and (timestamp .. cleanMsg) or cleanMsg
	local filteredFinal = applyFilters(finalMsg)
	label.Text = filteredFinal
	label.LayoutOrder = #logs + 1
	label.TextTransparency = console._textTransparency
	local data = {label = label, time = timestamp, msg = cleanMsg, color = defaultColor}
	table.insert(logs, data)

	local query = searchText()
	if query ~= '' then
		label.Visible = string.find(string.lower(filteredFinal), query, 1, true) ~= nil
	end

	if autoCopyEnabled and setclipboard then
		local full = ''
		for _, v in pairs(logs) do
			if v.label.Visible then full = full .. v.label.Text .. '\n' end
		end
		setclipboard(full)
	end

	local lastClick = 0
	renderer:Connect(label.InputBegan, function(input)
		local inputType = input.UserInputType
		if inputType ~= Enum.UserInputType.MouseButton1 and inputType ~= Enum.UserInputType.Touch then return end
		local now = tick()
		if now - lastClick < 0.4 and setclipboard then
			setclipboard(applyFilters(cleanMsg))
			flashCopied(label, defaultColor)
		end
		lastClick = now
	end)

	if wasAtBottom then
		task.defer(pinToBottom)
	end
end

