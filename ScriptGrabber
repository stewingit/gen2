local function newElement(window, parent, name, icon)
	return {window = window, tab = {tabPage = parent}, name = name or '', icon = icon, connections = {}}
end

function Window.new(opts)
	local layout = table.clone(layouts.top)
	layout.chromeHeight = layout.topbarHeight

	local themeManager = ThemeManager.new{theme = CONFIG.Theme, label = 'Script Grabber'}
	local renderer = Renderer.new{themeManager = themeManager}
	local self = setmetatable({
		name = opts.name,
		subheading = opts.subtitle,
		icon = opts.icon,
		layout = layout,
		size = UDim2.fromOffset(opts.width, opts.height),
		themeManager = themeManager,
		renderer = renderer,
		theme = themeManager.theme,
		instances = renderer.instances,
		connections = renderer.connections,
		live = {},
		popups = {},
		hidden = true,
		animating = false,
		unloaded = false,
		revealed = false,
		onClose = opts.onClose,
	}, Window)
	renderer.interactive = function() return self:_interactive() end

	WindowFrame.shell(renderer, self)
	if opts.position then self.main.Position = opts.position end
	WindowFrame.chrome(renderer, self)
	WindowFrame.actionBar(renderer, self)

	self.tab = {window = self, name = 'Page', customOrder = 0}
	Page.build(renderer, self.tab, self.elements)
	self.selectedTab = self.tab
	self.elementsLayout:JumpTo(self.tab.tabPage)
	self.page = self.tab.tabPage

	self.closeAction = {window = self, name = 'Close'}
	IconButton.build(renderer, self.closeAction, {name = 'Close', icon = Styles.Icons.close, parent = self.actionContainer, order = 1})
	local function rest()
		if not self:_settled() then return end
		IconButton.fade(self.closeAction, 'rest')
	end
	IconButton.wire(renderer, self.closeAction, {
		canHover = function() return self:_interactive() end,
		onClick = function()
			if self.onClose then task.spawn(self.onClose) end
			rest()
		end,
		onLeave = rest,
	})

	self:_bindDrag()
	self:Connect(variables.userInputService.InputBegan, function(input)
		if input.KeyCode ~= Enum.KeyCode.Escape then return end
		local top = self.popups[#self.popups]
		if top and top.dismissable then top:Close() end
	end)
	return self
end

function Window:Connect(signal, callback) return self.renderer:Connect(signal, callback) end
function Window:Disconnect(connection) self.renderer:Disconnect(connection) end
function Window:_interactive() return not self.animating and not self.hidden end
function Window:_settled() return not self.hidden and not self.animating end
function Window:SetTitle(text) if self.title then self.title.Text = text end end

function Window:_bindDrag()
	local uis = variables.userInputService
	local S = Styles.DragBar
	local bar = {window = self}
	DragBar.build(self.renderer, bar)
	self.drag = bar
	local dragging, offset, inset = false, Vector2.zero, Vector2.zero
	if self.screenGui.IgnoreGuiInset then inset = variables.guiService:GetGuiInset() end

	local function targets()
		local pos = uis:GetMouseLocation() + offset + inset
		local x, y = pos.X, pos.Y
		local size, screen, margin = self.main.AbsoluteSize, self.screenGui.AbsoluteSize, S.screenMargin
		local hx, hy = size.X / 2, size.Y / 2
		x = math.clamp(x, hx + margin, math.max(hx + margin, screen.X - hx - margin))
		y = math.clamp(y, hy + margin, math.max(hy + margin, screen.Y - hy - margin))
		return UDim2.fromOffset(x, y), UDim2.fromOffset(x, y + (self.main.Size.Y.Offset / 2 + S.gap))
	end

	local function release()
		if not dragging then return end
		dragging = false
		if not self:_interactive() then return end
		local mainTarget, barTarget = targets()
		DragBar.release(bar, mainTarget, barTarget)
	end

	self:Connect(bar.drag.MouseEnter, function()
		if not dragging and not self.hidden then DragBar.hover(bar, true) end
	end)
	self:Connect(bar.drag.MouseLeave, function()
		if not dragging and not self.hidden then DragBar.hover(bar, false) end
	end)
	self:Connect(bar.dragInteract.InputBegan, function(input, processed)
		if processed then return end
		local kind = input.UserInputType.Name
		if kind ~= 'MouseButton1' and kind ~= 'Touch' then return end
		if not self:_interactive() then return end
		dragging = true
		if self.screenGui.IgnoreGuiInset then inset = variables.guiService:GetGuiInset() end
		offset = self.main.AbsolutePosition + self.main.AbsoluteSize * self.main.AnchorPoint - uis:GetMouseLocation()
		DragBar.press(bar)
	end)
	self:Connect(uis.InputEnded, function(input)
		local kind = input.UserInputType.Name
		if kind == 'MouseButton1' or kind == 'Touch' then release() end
	end)
	self:Connect(uis.WindowFocusReleased, release)
	self:Connect(variables.runService.RenderStepped, function(dt)
		if not dragging then return end
		if not self:_interactive() then
			release()
			return
		end
		local mainTarget, barTarget = targets()
		DragBar.follow(bar, mainTarget, barTarget, dt)
	end)
end

function Window:_showDragBar(shown)
	local bar = self.drag
	if shown then
		local position = self.main.Position
		bar.drag.Position = UDim2.new(position.X.Scale, position.X.Offset, position.Y.Scale, position.Y.Offset + (self.size.Y.Offset / 2 + Styles.DragBar.gap))
		bar.drag.Visible = true
		Animator.play(bar.dragCosmetic, presets.Expo_0_6, {BackgroundTransparency = Styles.DragBar.cosmetic.rest.transparency, Size = UDim2.fromOffset(Styles.DragBar.cosmetic.rest.width, Styles.DragBar.cosmetic.height)})
	else
		Animator.play(bar.dragCosmetic, presets.Quint_0_18, {BackgroundTransparency = 1, Size = Styles.DragBar.cosmetic.hidden})
		task.delay(0.18, function()
			if self.hidden and not self.unloaded then bar.drag.Visible = false end
		end)
	end
end

function Window:_reveal(instance, goals, animate)
	if not instance then return end
	if animate then
		Animator.play(instance, presets.Expo_0_4, goals)
	else
		for property, value in goals do instance[property] = value end
	end
end

function Window:_revealCommon(el, animate)
	self:_reveal(el.stroke, {Transparency = self.theme.ElementStrokeTransparency}, animate)
	self:_reveal(el.title, {TextTransparency = 0}, animate)
	self:_reveal(el.main, {BackgroundTransparency = self.theme.ElementTransparency or 0}, animate)
	if el.iconLabel then self:_reveal(el.iconLabel, {ImageTransparency = 0}, animate) end
end

function Window:_hideCommon(el, animate)
	self:_reveal(el.stroke, {Transparency = 1}, animate)
	self:_reveal(el.title, {TextTransparency = 1}, animate)
	self:_reveal(el.main, {BackgroundTransparency = 1}, animate)
	if el.iconLabel then self:_reveal(el.iconLabel, {ImageTransparency = 1}, animate) end
end

function Window:_fadeSurfaces(shown, info)
	local goals = {
		[self.windowShadow] = {Transparency = if shown then 0.6 else 1},
		[self.windowStroke] = {Transparency = if shown then 0.95 else 1},
		[self.bottomFade] = {BackgroundTransparency = if shown then 0 else 1},
	}
	for instance, props in goals do
		if info then Animator.play(instance, info, props) else
			for property, value in props do instance[property] = value end
		end
	end
end

function Window:_fadeChrome(shown, info)
	if self.topbarIcon then Animator.play(self.topbarIcon, info, {ImageTransparency = if shown then 0 else 1}) end
	if self.title then Animator.play(self.title, info, {TextTransparency = if shown then 0 else 1}) end
	if self.subtitle then Animator.play(self.subtitle, info, {TextTransparency = if shown then 0.7 else 1}) end
	Animator.play(self.closeAction.iconLabel, info, {ImageTransparency = if shown then 0.6 else 1})
end

function Window:_add(el)
	table.insert(self.live, el)
	if self.revealed then el:_setShown(true, true) end
end

function Window:RemoveElement(el)
	local index = table.find(self.live, el)
	if index then table.remove(self.live, index) end
	for _, connection in el.connections do self.renderer:Disconnect(connection) end
	el.connections = {}
	if el.main then self.renderer:DestroySubtree(el.main) end
end

function Window:CreateButton(parent, opts)
	local el = newElement(self, parent, opts.name, opts.icon)
	local style = table.clone(Styles.Button.full)
	if opts.size then
		style.size = opts.size
		style.pressedSize = opts.pressedSize or opts.size
	end
	for key, value in opts.style or {} do style[key] = value end
	local callback = opts.callback
	ButtonBase.buildFull(self.renderer, el, function()
		task.spawn(function()
			local ok, err = pcall(callback)
			if not ok then warn('Script Grabber: button callback failed - ' .. tostring(err)) end
		end)
	end, {style = style})
	if opts.order then el.main.LayoutOrder = opts.order end
	function el._setShown(e, shown, animate)
		if shown then self:_revealCommon(e, animate) else self:_hideCommon(e, animate) end
	end
	self:_add(el)
	return el
end

function Window:CreateRow(parent, opts)
	local renderer = self.renderer
	local frame = renderer:Create('Frame', {Name = 'Row', Size = UDim2.new(1, -20, 0, 43), BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = opts.order, Parent = parent})
	renderer:Create('UIListLayout', {FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = frame})
	local row = {frame = frame}
	row.main = self:CreateButton(frame, {
		name = opts.name, icon = opts.icon, callback = opts.onOpen, order = 1,
		size = UDim2.new(1, -46, 0, 43), pressedSize = UDim2.new(1, -52, 0, 43),
		style = {textSize = 14},
	})
	row.edit = self:CreateButton(frame, {
		name = '', icon = opts.editIcon, callback = opts.onEdit, order = 2,
		size = UDim2.fromOffset(40, 43), pressedSize = UDim2.fromOffset(34, 43),
		style = {containerSize = UDim2.fromOffset(16, 16), containerPosition = UDim2.new(0, 12, 0.5, 0), gap = 0, titleSize = UDim2.fromOffset(0, 16)},
	})
	return row
end

function Window:RemoveRow(row)
	self:RemoveElement(row.main)
	self:RemoveElement(row.edit)
	self.renderer:DestroySubtree(row.frame)
end

function Window:CreateInput(parent, opts)
	local renderer = self.renderer
	local el = newElement(self, parent, opts.name, opts.icon)
	el.placeholder = opts.placeholder or ''
	Panel.card(renderer, el, Styles.Field.card)
	Field.build(renderer, el, {parent = el.main, glow = function(...) return renderer:CreateGlow(...) end})
	Field.buildTextBox(renderer, el, {text = '', placeholder = el.placeholder, clearOnFocus = false})
	el.box.Size = UDim2.new(1, -130, 0, 30)
	el.input.TextXAlignment = Enum.TextXAlignment.Left
	el.input.Size = UDim2.new(1, -24, 0, 15)
	renderer:ConnectFor(el, el.input.Focused, function()
		Animator.play(el.input, Styles.Field.tween.focus, {TextTransparency = Styles.Field.text.focused})
	end)
	renderer:ConnectFor(el, el.input.FocusLost, function()
		Animator.play(el.input, Styles.Field.tween.focus, {TextTransparency = Styles.Field.text.idle})
	end)
	renderer:ConnectFor(el, el.input:GetPropertyChangedSignal('Text'), function()
		if opts.onChanged then opts.onChanged(el.input.Text) end
	end)
	Panel.wireHover(renderer, el)
	if opts.order then el.main.LayoutOrder = opts.order end
	function el._setShown(e, shown, animate)
		if shown then self:_revealCommon(e, animate) else self:_hideCommon(e, animate) end
		Field.setShown(function(instance, goals, a) self:_reveal(instance, goals, a) end, renderer, e, shown, animate)
	end
	self:_add(el)
	return el
end

function Window:CreateProgress(parent, opts)
	local renderer = self.renderer
	local el = newElement(self, parent, opts.name, opts.icon)
	el.min, el.max, el.value, el.showValue, el.indeterminate = 0, 1, 0, false, false
	function el._ratio(e) return e.value end
	function el._readout(e) return string.format('%d%%', math.round(e.value * 100)) end
	function el.Set(e, value)
		e.value = math.clamp(value, 0, 1)
		ProgressBar.render(e)
	end
	ProgressBar.build(renderer, el, function(...) return renderer:CreateGlow(...) end)
	if opts.order then el.main.LayoutOrder = opts.order end
	function el._setShown(e, shown, animate)
		e._shown = shown
		if shown then self:_revealCommon(e, animate) else self:_hideCommon(e, animate) end
		self:_reveal(e.readout, {TextTransparency = if shown then Styles.Progress.readout.shownTransparency else 1}, animate)
		self:_reveal(e.track, {BackgroundTransparency = if shown then 0 else 1}, animate)
		self:_reveal(e.fill, {BackgroundTransparency = if shown then 0 else 1}, animate)
		self:_reveal(e.fillGlow, {Transparency = if shown then self.theme.AccentGlow else 1}, animate)
	end
	self:_add(el)
	return el
end

function Window:Popup(opts)
	if self.unloaded then return end
	local renderer, window = self.renderer, self
	local popup = {
		window = self,
		title = opts.title or 'Popup',
		subtitle = opts.subtitle,
		content = opts.content,
		icon = opts.icon,
		options = if opts.options and #opts.options > 0 then opts.options else {{text = 'Okay'}},
		dismissable = opts.dismissable ~= false,
		_reveal = {},
		_connections = {},
		_closed = false,
	}

	function popup:_activate(callback)
		if self._closed then return end
		local text = if self.input then self.input.Text else nil
		self:Close()
		if callback then
			task.spawn(function()
				local ok, err = pcall(callback, text)
				if not ok then warn('Script Grabber: popup callback failed - ' .. tostring(err)) end
			end)
		end
	end

	function popup:Close()
		if self._closed then return end
		self._closed = true
		local index = table.find(window.popups, self)
		if index then table.remove(window.popups, index) end
		for _, connection in self._connections do window:Disconnect(connection) end
		self._connections = {}
		Dialog.hide(renderer, self)
	end

	Dialog.build(renderer, popup)

	if opts.input then
		local D = Styles.Dialog
		local height = 38
		local holder = renderer:Create('Frame', {Name = 'Input', Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = 2, Parent = popup.card})
		local box = {}
		Field.build(renderer, box, {parent = holder, glow = function(...) return renderer:CreateGlow(...) end})
		box.box.AnchorPoint = Vector2.new(0.5, 0.5)
		box.box.Position = UDim2.fromScale(0.5, 0.5)
		box.box.Size = UDim2.new(1, 0, 1, 0)
		Field.buildTextBox(renderer, box, {text = opts.input.text or '', placeholder = opts.input.placeholder or '', clearOnFocus = false})
		box.input.Size = UDim2.new(1, -24, 0, 18)
		box.input.TextSize = 16
		popup.input = box.input
		Dialog.fade(popup, box.box, 'BackgroundTransparency', self.theme.FieldTransparency)
		Dialog.fade(popup, box.boxStroke, 'Transparency', Styles.Field.box.strokeTransparency)
		Dialog.fade(popup, box.input, 'TextTransparency', 0.1)
		popup.card.Size = UDim2.fromOffset(D.width, popup.card.Size.Y.Offset + height + D.gap)

		local limit = opts.input.limit
		if limit then
			table.insert(popup._connections, renderer:Connect(box.input:GetPropertyChangedSignal('Text'), function()
				if #box.input.Text > limit then box.input.Text = box.input.Text:sub(1, limit) end
			end))
		end

		table.insert(popup._connections, renderer:Connect(box.input.FocusLost, function(enterPressed)
			if not enterPressed then return end
			for _, option in popup.options do
				if type(option) == 'table' and (option.style or option.Style) == 'primary' then
					popup:_activate(option.callback or option.Callback)
					return
				end
			end
		end))
	end

	if popup.dismissable then
		table.insert(popup._connections, renderer:Connect(popup.backdrop.InputBegan, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				popup:Close()
			end
		end))
	end

	table.insert(self.popups, popup)
	task.spawn(function()
		Dialog.show(popup)
		if popup.input and not popup._closed then
			task.wait(0.25)
			if not popup._closed and popup.input.Parent then popup.input:CaptureFocus() end
		end
	end)
	return popup
end

function Window:Show()
	if self.unloaded or not self.hidden or self.animating then return end
	self.animating = true
	self.hidden = false
	self.main.Visible = true
	task.spawn(function()
		Animator.play(self.main, presets.ExpoInOut_1, {BackgroundTransparency = 0, Size = self.size})
		task.wait(0.7)
		if self.unloaded then return end
		self:_fadeSurfaces(true, presets.Expo_0_6)
		self:_fadeChrome(true, presets.Expo_0_4)
		self:_showDragBar(true)
		task.wait(0.15)
		if self.unloaded then return end
		self.revealed = true
		for _, el in self.live do
			el:_setShown(true, true)
			task.wait(0.03)
		end
		self.animating = false
	end)
end

function Window:Hide()
	if self.unloaded or self.hidden or self.animating then return end
	self.animating = true
	self.hidden = true
	self.revealed = false
	local quick = presets.Quint_0_18
	self:_fadeSurfaces(false, quick)
	self:_fadeChrome(false, quick)
	self:_showDragBar(false)
	for _, el in self.live do el:_setShown(false, true) end
	local tween = Animator.play(self.main, presets.ExpoInOut_0_35, {
		Size = UDim2.fromOffset(self.size.X.Offset - WS.widthTrim, 0),
		BackgroundTransparency = 1,
	})
	tween.Completed:Connect(function()
		if self.unloaded then return end
		self.main.Visible = false
		self.animating = false
	end)
end

function Window:Unload()
	if self.unloaded then return end
	self.unloaded = true
	for index = #self.connections, 1, -1 do pcall(function() self.connections[index]:Disconnect() end) end
	for index = #self.instances, 1, -1 do pcall(function() self.instances[index]:Destroy() end) end
	table.clear(self.connections)
	table.clear(self.instances)
	table.clear(self.themeManager.bindings)
	table.clear(self.renderer.localeProperties)
	table.clear(self.live)
	table.clear(self.popups)
end

