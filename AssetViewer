local function makeAction(name, icon, order, callback)
	local action = {window = window, name = name, icon = icon}
	IconButton.build(renderer, action, {name = name, icon = icon, parent = window.actionContainer, order = order})
	IconButton.wire(renderer, action, {
		canHover = function() return window:_interactive() end,
		onClick = function() task.spawn(callback) end,
		onLeave = function()
			if window:_interactive() then IconButton.fade(action, 'rest') end
		end,
	})
	return action
end

local closeAction = makeAction('Close', Styles.Icons.close, 1, function()
	if window.unloaded then return end
	window:Popup({
		title = 'Close Asset Viewer?',
		subtitle = 'This destroys the window',
		content = 'Any previews you spawned into the world will be removed too.',
		icon = 'x',
		options = {
			{text = 'Cancel'},
			{text = 'Destroy', style = 'danger', callback = function() window:Close() end},
		},
	})
end)
local minimiseAction = makeAction('Collapse', Styles.Icons.minimise, 2, function() window:ToggleHide() end)

local function setTag(typeName)
	if not typeName then
		if tag then Pill.setShown(tag, false, true) end
		return
	end
	local color = TagColors[typeName] or Styles.Tag.defaultColor
	if not tag then
		tag = {window = window}
		Pill.build(renderer, tag, {name = 'Tag', parent = window.tagContainer, order = 0, color = color, text = typeName})
		window.tagContainer.Visible = true
	else
		Pill.setColor(tag, color)
		Pill.setText(tag, typeName)
	end
	Pill.setShown(tag, true, true)
end

local function setBusy(on, text)
	if on then
		activity:SetTitle(text or 'Working...')
		activity.main.Visible = true
		activity:SetIndeterminate(true)
	else
		activity:SetIndeterminate(false)
		activity.main.Visible = false
	end
end

local function setMediaControls(on)
	mediaRow.main.Visible = on
	playback.main.Visible = on
	if not on then
		playBtn:SetText('Play')
		playBtn:SetIcon('play')
	end
end

local function setContext(label, icon)
	contextBtn.main.Visible = label ~= nil
	if label then
		contextBtn:SetText(label)
		contextBtn:SetIcon(icon or 'box')
	end
	local alive = false
	for _, object in spawned do
		if object and object.Parent then alive = true break end
	end
	deleteBtn.main.Visible = alive
	contextRow.main.Visible = label ~= nil or alive
end

local function stopTrack()
	if currentTrack then
		pcall(function() currentTrack:Stop() end)
		currentTrack = nil
	end
end

function W:StopMedia()
	pcall(function() audio:Stop() end)
	audio.TimePosition = 0
	preview.video.Playing = false
	preview.video.TimePosition = 0
	playBtn:SetText('Play')
	playBtn:SetIcon('play')
end

function W:ToggleMedia()
	if mediaKind == 'video' then
		if preview.video.Playing then
			preview.video.Playing = false
			playBtn:SetText('Play')
			playBtn:SetIcon('play')
		else
			preview.video.Playing = true
			playBtn:SetText('Pause')
			playBtn:SetIcon('pause')
		end
	elseif mediaKind == 'audio' then
		if audio.Playing then
			audio:Pause()
			playBtn:SetText('Play')
			playBtn:SetIcon('play')
		else
			if audio.IsPaused then audio:Resume() else audio:Play() end
			playBtn:SetText('Pause')
			playBtn:SetIcon('pause')
		end
	end
end

renderer:Connect(audio.Ended, function()
	playBtn:SetText('Play')
	playBtn:SetIcon('play')
end)
renderer:Connect(preview.video.Ended, function()
	playBtn:SetText('Play')
	playBtn:SetIcon('play')
	preview.video.TimePosition = 0
end)

do 
	local acc = 0
	renderer:Connect(variables.runService.Heartbeat, function(dt)
		acc += dt
		if acc < 0.1 then return end
		acc = 0
		if not mediaKind or window.hidden or window.unloaded then return end
		local player = if mediaKind == 'video' then preview.video else audio
		local position, length = player.TimePosition or 0, player.TimeLength or 0
		if length <= 0 then
			playback:SetText('Loading...')
			return
		end
		playback:SetRange(0, length)
		playback.text = formatTime(position) .. ' / ' .. formatTime(length)
		playback:Set(position)
	end)
end

function W:ClearSpawned(notify)
	local count = 0
	for _, object in spawned do
		if object and object.Parent then
			count += 1
			pcall(function() object:Destroy() end)
		end
	end
	spawned = {}
	deleteBtn.main.Visible = false
	contextRow.main.Visible = contextBtn.main.Visible
	if notify then
		window:Toast({title = if count > 0 then 'Removed spawned objects' else 'Nothing to remove', icon = 'trash-2'})
	end
end

local function track(object)
	table.insert(spawned, object)
	if autoRemove then Debris:AddItem(object, SPAWN_LIFETIME) end
	deleteBtn.main.Visible = true
	contextRow.main.Visible = true
end

local function spawnCFrame()
	local char = LocalPlayer and LocalPlayer.Character
	local hrp = char and char:FindFirstChild('HumanoidRootPart')
	if not hrp then
		window:Toast({title = 'No character found', subtitle = 'Respawn and try again', icon = 'x'})
		return nil
	end
	return hrp.CFrame * CFrame.new(0, 0, -5), char
end

local function contextFor(assetType)
	if assetType == 24 then
		return 'Play Animation', 'play', function()
			local cf, char = spawnCFrame()
			if not cf then return end
			if currentTrack then
				stopTrack()
				contextBtn:SetText('Play Animation')
				contextBtn:SetIcon('play')
				return
			end
			local humanoid = char:FindFirstChildOfClass('Humanoid')
			if not humanoid then
				window:Toast({title = 'No humanoid found', icon = 'x'})
				return
			end
			local animator = humanoid:FindFirstChildOfClass('Animator')
			if not animator then
				animator = Instance.new('Animator')
				animator.Parent = humanoid
			end
			local anim = Instance.new('Animation')
			anim.AnimationId = 'rbxassetid://' .. currentId
			local ok, loaded = pcall(function() return animator:LoadAnimation(anim) end)
			if not ok or not loaded then
				window:Toast({title = 'Could not load animation', subtitle = 'It may be restricted', icon = 'x'})
				return
			end
			loaded:Play()
			currentTrack = loaded
			contextBtn:SetText('Stop Animation')
			contextBtn:SetIcon('square')
		end
	elseif assetType == 2 or assetType == 11 or assetType == 12 then
		return 'Spawn Avatar Preview', 'user', function()
			local cf = spawnCFrame()
			if not cf then return end
			local desc = Instance.new('HumanoidDescription')
			if assetType == 2 then desc.GraphicTShirt = tonumber(currentId)
			elseif assetType == 11 then desc.Shirt = tonumber(currentId)
			else desc.Pants = tonumber(currentId) end
			local ok, dummy = pcall(function()
				return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
			end)
			if not ok or not dummy then
				window:Toast({title = 'Failed to load preview', icon = 'x'})
				return
			end
			for _, part in dummy:GetDescendants() do
				if part:IsA('BasePart') then part.Color = Color3.fromRGB(163, 162, 165) end
			end
			dummy:PivotTo(cf * CFrame.Angles(0, math.pi, 0))
			dummy.Parent = workspace
			track(dummy)
			window:Toast({title = 'Spawned avatar preview', icon = 'check'})
		end
	elseif assetType == 1 then
		return 'Spawn Preview Part', 'image', function()
			local cf = spawnCFrame()
			if not cf then return end
			local part = Instance.new('Part')
			part.Size = Vector3.new(4, 4, 1)
			part.CFrame = cf
			part.Anchored = true
			part.CanCollide = false
			part.Parent = workspace
			local decal = Instance.new('Decal')
			decal.Face = Enum.NormalId.Front
			decal.Texture = 'rbxassetid://' .. currentId
			decal.Parent = part
			track(part)
			window:Toast({title = 'Spawned preview part', icon = 'check'})
		end
	elseif ModelTypes[assetType] then
		return 'Spawn Model', 'box', function()
			local cf = spawnCFrame()
			if not cf then return end
			local ok, objects = pcall(function() return game:GetObjects('rbxassetid://' .. currentId) end)
			if not ok or not objects then
				window:Toast({title = 'Failed / restricted', subtitle = 'This asset cannot be loaded', icon = 'x'})
				return
			end
			for _, object in objects do
				if object:IsA('Model') then
					object:MoveTo(cf.Position)
				elseif object:IsA('BasePart') then
					object.CFrame = cf
				end
				object.Parent = workspace
				track(object)
			end
			window:Toast({title = 'Spawned model', icon = 'check'})
		end
	end
	return nil
end

function W:Search()
	local query = self.searchInput.Text
	if query == '' then return end

	searchToken += 1
	local token = searchToken

	self:StopMedia()
	stopTrack()
	mediaKind = nil
	contextAction = nil
	setMediaControls(false)
	setContext(nil)
	preview.video.Visible = false
	preview.image.Visible = true
	preview.image.ImageTransparency = 1
	preview.empty.Visible = true
	info:SetTitle('Status')
	info:Set('Searching...')
	setBusy(true, 'Searching...')

	task.spawn(function()
		local data = registry.search(query)
		if token ~= searchToken or window.unloaded then return end

		if not data.Success then
			info:SetTitle('Status')
			info:Set(esc(data.Status))
			currentId, currentInfo = '', nil
			saveBtn:SetText('Download')
			setTag(nil)
			setBusy(false)
			return
		end

		local assetInfo = data.Info
		currentId = tostring(assetInfo.Id)
		currentInfo = assetInfo
		local assetType = assetInfo.AssetType
		local typeName = AssetTypes[assetType] or 'Asset'

		info:SetTitle(esc(assetInfo.Name))
		info:Set(string.format('<b>Type</b>  %s\n<b>Creator</b>  %s\n<b>ID</b>  %s', esc(assetInfo.TypeName), esc(assetInfo.Creator), currentId))
		saveBtn:SetText('Download ' .. typeName)
		setTag(typeName)

		renderer.assign(preview.image, 'Image', 'rbxthumb://type=Asset&id=' .. currentId .. '&w=420&h=420')
		pcall(function() ContentProvider:PreloadAsync({preview.image}) end)
		if token ~= searchToken or window.unloaded then return end
		preview.empty.Visible = false
		Animator.play(preview.image, Animator.presets.Quint_0_4, {ImageTransparency = 0})

		if assetType == 3 then
			mediaKind = 'audio'
			audio.SoundId = 'rbxassetid://' .. currentId
			setMediaControls(true)
		elseif assetType == 62 then
			mediaKind = 'video'
			preview.video.Video = 'rbxassetid://' .. currentId
			preview.video.Visible = true
			preview.image.Visible = false
			setMediaControls(true)
			task.spawn(function()
				local started = os.clock()
				repeat task.wait() until preview.video.Resolution ~= Vector2.zero or os.clock() - started > 10 or token ~= searchToken
				if preview.video.Resolution.Y > 0 then
					videoAspect.AspectRatio = preview.video.Resolution.X / preview.video.Resolution.Y
				end
			end)
		else
			local label, icon, action = contextFor(assetType)
			if label then
				contextAction = action
				setContext(label, icon)
			end
		end
		setBusy(false)
	end)
end

local function safeName(name)
	local cleaned = (tostring(name):gsub('[^%w%s]', ''))
	if cleaned == '' then cleaned = 'asset' end
	return cleaned
end

local function ensureFolder()
	pcall(function()
		if isfolder and makefolder and not isfolder(SAVE_FOLDER) then makefolder(SAVE_FOLDER) end
	end)
end

local function downloadAsImage()
	if not currentInfo then return end
	local id, name = currentId, currentInfo.Name
	setBusy(true, 'Downloading image...')
	task.spawn(function()
		ensureFolder()
		local thumbData
		local url = 'https://thumbnails.roblox.com/v1/assets?assetIds=' .. id .. '&returnPolicy=PlaceHolder&size=420x420&format=Png&isCircular=false'
		local ok, response = pcall(function() return game:HttpGet(url) end)
		if ok and response then
			local decodeOk, decoded = pcall(function() return HttpService:JSONDecode(response) end)
			local imageUrl = decodeOk and decoded and decoded.data and decoded.data[1] and decoded.data[1].imageUrl
			if imageUrl then
				local imgOk, imgData = pcall(function() return game:HttpGet(imageUrl) end)
				if imgOk then thumbData = imgData end
			end
		end
		setBusy(false)
		if thumbData and #thumbData > 100 then
			local path = string.format('%s/%s_%s.png', SAVE_FOLDER, safeName(name), id)
			local wrote = pcall(writefile, path, thumbData)
			if wrote then
				window:Toast({title = 'Saved to files', subtitle = path, icon = 'check'})
				return
			end
		end
		window:Toast({title = 'Download failed', subtitle = 'Could not save the image', icon = 'x'})
	end)
end

function W:Download()
	if currentId == '' or not currentInfo then
		window:Toast({title = 'Nothing to download', subtitle = 'Search for an asset first', icon = 'x'})
		return
	end
	if not writefile then
		window:Toast({title = 'No writefile support', subtitle = 'Your executor cannot save files', icon = 'x'})
		return
	end

	local assetType = currentInfo.AssetType
	if assetType == 1 then
		downloadAsImage()
		return
	end

	local id, name = currentId, currentInfo.Name
	setBusy(true, 'Downloading...')
	task.spawn(function()
		ensureFolder()
		local ext = ExtensionMap[assetType] or ExtensionMap.Default
		local ok, res = pcall(function() return game:HttpGet('https://assetdelivery.roblox.com/v1/asset/?id=' .. id) end)
		setBusy(false)
		if ok and type(res) == 'string' and #res > 500 then
			local path = string.format('%s/%s_%s%s', SAVE_FOLDER, safeName(name), id, ext)
			local wrote = pcall(writefile, path, res)
			if wrote then
				window:Toast({title = 'Saved to files', subtitle = path, icon = 'check'})
			else
				window:Toast({title = 'Download failed', subtitle = 'Could not write the file', icon = 'x'})
			end
			return
		end
		window:Popup({
			title = 'Download denied',
			subtitle = 'The raw asset could not be fetched',
			content = 'This asset is probably private or protected. You can save its thumbnail image instead.',
			icon = 'download',
			options = {
				{text = 'Cancel'},
				{text = 'Download image', style = 'primary', callback = downloadAsImage},
			},
		})
	end)
end

do
	local dragging, grab = false, Vector2.zero
	local style = Styles.DragBar

	local function inset()
		if window.screenGui.IgnoreGuiInset then return variables.guiService:GetGuiInset() end
		return Vector2.zero
	end

	local function target()
		local point = UIS:GetMouseLocation() + grab + inset()
		local x, y = point.X, point.Y
		if window.settings.keepOnScreen then
			local mainSize, screenSize, margin = window.main.AbsoluteSize, window.screenGui.AbsoluteSize, style.screenMargin
			local halfX, halfY = mainSize.X / 2, mainSize.Y / 2
			x = math.clamp(x, halfX + margin, math.max(halfX + margin, screenSize.X - halfX - margin))
			y = math.clamp(y, halfY + margin, math.max(halfY + margin, screenSize.Y - halfY - margin))
		end
		return UDim2.fromOffset(x, y), UDim2.fromOffset(x, y + window.main.Size.Y.Offset / 2 + style.gap)
	end

	local function isPress(input)
		local name = input.UserInputType.Name
		return name == 'MouseButton1' or name == 'Touch'
	end

	local function begin()
		if not window:_interactive() then return end
		dragging = true
		grab = window.main.AbsolutePosition + window.main.AbsoluteSize * window.main.AnchorPoint - UIS:GetMouseLocation()
		DragBar.press(bar)
	end

	local function finish()
		if not dragging then return end
		dragging = false
		if window.unloaded or not window:_interactive() then return end
		local mainPosition, barPosition = target()
		DragBar.release(bar, mainPosition, barPosition)
	end

	local function overActions(position)
		local at, size = window.actionContainer.AbsolutePosition, window.actionContainer.AbsoluteSize
		return position.X >= at.X and position.X <= at.X + size.X and position.Y >= at.Y and position.Y <= at.Y + size.Y
	end

	renderer:Connect(window.topbar.InputBegan, function(input, processed)
		if processed or not isPress(input) then return end
		if overActions(input.Position) then return end
		begin()
	end)
	renderer:Connect(bar.dragInteract.InputBegan, function(input, processed)
		if processed or not isPress(input) then return end
		begin()
	end)
	renderer:Connect(bar.dragInteract.MouseEnter, function()
		if not dragging and not window.hidden then DragBar.hover(bar, true) end
	end)
	renderer:Connect(bar.dragInteract.MouseLeave, function()
		if not dragging and not window.hidden then DragBar.hover(bar, false) end
	end)
	renderer:Connect(UIS.InputEnded, function(input)
		if isPress(input) then finish() end
	end)
	renderer:Connect(UIS.WindowFocusReleased, finish)
	renderer:Connect(variables.runService.RenderStepped, function(dt)
		if not dragging then return end
		if not window:_interactive() then
			dragging = false
			return
		end
		local mainPosition, barPosition = target()
		DragBar.follow(bar, mainPosition, barPosition, dt)
	end)
end

function W:_syncDragBar()
	local position = self.main.Position
	bar.drag.Position = UDim2.new(position.X.Scale, position.X.Offset, position.Y.Scale, position.Y.Offset + self.size.Y.Offset / 2 + Styles.DragBar.gap)
end

do
	local acc = 0
	renderer:Connect(variables.runService.Heartbeat, function(dt)
		acc += dt
		if acc < 0.5 or window.unloaded then return end
		acc = 0
		local newSize = fitSize()
		if newSize ~= window.size then
			window.size = newSize
			if not (window.hidden or window.animating) then
				window.main.Size = newSize
				window:_syncDragBar()
			end
		end
	end)
end

function W:_revealAll(step)
	for index, el in ipairs(page.elements) do
		el:_setShown(true, true)
		if step and index <= 14 then task.wait(step) end
	end
end

function W:_clampedPosition(position)
	if not self.settings.keepOnScreen then return position end
	if position.X.Scale ~= 0 or position.Y.Scale ~= 0 then return position end
	local screen, halfX, halfY, margin = self.screenGui.AbsoluteSize, self.size.X.Offset / 2, self.size.Y.Offset / 2, 8
	local x = math.clamp(position.X.Offset, halfX + margin, math.max(halfX + margin, screen.X - halfX - margin))
	local y = math.clamp(position.Y.Offset, halfY + margin, math.max(halfY + margin, screen.Y - halfY - margin))
	return UDim2.fromOffset(x, y)
end

local COLLAPSED_SIZE = UDim2.fromOffset(185, 50)
local COLLAPSED_ICON_SIZE = UDim2.fromOffset(50, 50)
local COLLAPSED_BASE = UDim2.new(0.5, 0, 0, 20)

function W:_collapsedRect()
	local size = if self.showIconOnly then COLLAPSED_ICON_SIZE else COLLAPSED_SIZE
	if self._collapsedPosition then return self._collapsedPosition, size end
	return UDim2.new(COLLAPSED_BASE.X.Scale, COLLAPSED_BASE.X.Offset, COLLAPSED_BASE.Y.Scale, COLLAPSED_BASE.Y.Offset + size.Y.Offset / 2), size
end

function W:_revealChrome(info)
	if self.topbarIcon then Animator.play(self.topbarIcon, info, {ImageTransparency = 0}) end
	if self.title then Animator.play(self.title, info, {TextTransparency = 0}) end
	if self.subtitle then Animator.play(self.subtitle, info, {TextTransparency = 0.7}) end
	IconButton.fade(closeAction, 'rest')
	IconButton.fade(minimiseAction, 'rest')
	if tag then Pill.setShown(tag, true, true) end
end

function W:Show()
	if self.animating or not self.hidden then return end
	self.animating = true
	self.hidden = false
	self.collapsedInteract.Visible = false
	if self.hasShownOnce then
		self:_restore()
	else
		self.hasShownOnce = true
		self:_firstShow()
	end
end

function W:_firstShow()
	self.main.Visible = true
	bar.drag.Visible = false

	Animator.play(self.main, Animator.presets.ExpoInOut_1, {BackgroundTransparency = 0, Size = self.size})
	task.wait(0.85)
	if self.unloaded then return end
	self:_fadeSurfaces(true, Animator.presets.Expo_0_6)
	task.wait(0.3)
	if self.unloaded then return end

	self:_revealChrome(Animator.presets.Expo_0_4)
	self:_fadeSearch(true, Animator.presets.Quint_0_4)
	task.wait(0.2)

	self:_revealAll(0.03)
	task.wait(0.5)
	if self.unloaded then return end

	self:_syncDragBar()
	bar.drag.Visible = true
	Animator.play(bar.dragCosmetic, Animator.presets.Expo_0_6, {BackgroundTransparency = 0.7})
	Animator.play(bar.dragCosmetic, Animator.presets.Expo_1, {Size = UDim2.fromOffset(100, 4)})
	self.animating = false
end

function W:Hide()
	if self.animating or self.hidden then return end
	self.animating = true
	self.hidden = true
	self.collapsedInteract.Visible = false
	self._restorePosition = self.main.Position

	local position, size = self:_collapsedRect()
	local fast, move, fade = Animator.presets.Quint_0_18, Animator.presets.ExpoInOut_0_35, Animator.presets.Quint_0_2

	Animator.play(bar.dragCosmetic, fast, {Size = UDim2.fromOffset(0, 4), BackgroundTransparency = 1})
	task.delay(0.18, function()
		if self.hidden and not self.unloaded then bar.drag.Visible = false end
	end)
	self:_fadeSurfaces(false, fast)
	self:_fadeSearch(false, fast)
	if self.title then Animator.play(self.title, fast, {TextTransparency = 1}) end
	if self.subtitle then Animator.play(self.subtitle, fast, {TextTransparency = 1}) end
	if self.topbarIcon then Animator.play(self.topbarIcon, fast, {ImageTransparency = 1}) end
	Animator.play(closeAction.iconLabel, fast, {ImageTransparency = 1})
	Animator.play(minimiseAction.iconLabel, fast, {ImageTransparency = 1})
	if tag then Pill.setShown(tag, false, true) end
	for _, el in page.elements do el:_setShown(false, true) end

	local tween = Animator.play(self.main, move, {Size = size, Position = position})
	tween.Completed:Connect(function()
		if self.unloaded or not self.hidden then return end
		self.collapsedInteract.Visible = true
		self.animating = false
	end)
	Animator.play(self.windowCorner, move, {CornerRadius = UDim.new(1, 0)})
	task.delay(0.18, function()
		if not self.hidden or self.unloaded then return end
		self.topbar.Visible = false
		self.elements.Visible = false
		self.searchPill.Visible = false
		CollapsedFace.setShown(self, true, fade)
	end)
end

function W:_restore()
	local position = self:_clampedPosition(self._restorePosition or UDim2.new(0.5, 0, 0.5, 0))
	self._restorePosition = position
	local move, fade = Animator.presets.ExpoInOut_0_35, Animator.presets.Expo_0_28

	CollapsedFace.setShown(self, false, Animator.presets.Quint_0_15)
	Animator.play(self.main, move, {Size = self.size, Position = position})
	Animator.play(self.windowCorner, move, {CornerRadius = self.theme.CornerRoundness})

	task.delay(0.22, function()
		if self.hidden or self.unloaded then return end
		self.topbar.Visible = true
		self.elements.Visible = true
		self.searchPill.Visible = true
		self:_fadeSurfaces(true, fade)
		self:_revealChrome(fade)
		self:_fadeSearch(true, Animator.presets.Quint_0_4)
		task.spawn(function() self:_revealAll(0.035) end)
		bar.drag.Position = UDim2.new(position.X.Scale, position.X.Offset, position.Y.Scale, position.Y.Offset + self.size.Y.Offset / 2 + Styles.DragBar.gap)
		bar.dragCosmetic.Size = UDim2.fromOffset(0, 4)
		bar.dragCosmetic.BackgroundTransparency = 1
		bar.drag.Visible = true
		Animator.play(bar.dragCosmetic, Animator.presets.Expo_0_6, {BackgroundTransparency = 0.7, Size = UDim2.fromOffset(100, 4)})
	end)
	task.delay(0.6, function() self.animating = false end)
end

function W:ToggleHide()
	if self.animating or self.unloaded then return end
	if self.hidden then self:Show() else self:Hide() end
end

do
	local dragging, moved, grab, startMouse = false, false, Vector2.zero, Vector2.zero
	local threshold = Styles.Collapsed.dragThreshold

	local function inset()
		if window.screenGui.IgnoreGuiInset then return variables.guiService:GetGuiInset() end
		return Vector2.zero
	end
	local function isPress(input)
		local name = input.UserInputType.Name
		return name == 'MouseButton1' or name == 'Touch'
	end

	renderer:Connect(window.collapsedInteract.InputBegan, function(input, processed)
		if processed or not window.hidden or window.animating or not isPress(input) then return end
		dragging, moved = true, false
		startMouse = UIS:GetMouseLocation()
		grab = window.main.AbsolutePosition + window.main.AbsoluteSize * window.main.AnchorPoint - startMouse
	end)
	renderer:Connect(UIS.InputEnded, function(input)
		if not isPress(input) or not dragging then return end
		dragging = false
		if moved then
			window._collapsedPosition = window.main.Position
			return
		end
		Haptic.click()
		window:ToggleHide()
	end)
	renderer:Connect(UIS.WindowFocusReleased, function() dragging = false end)
	renderer:Connect(variables.runService.RenderStepped, function()
		if not dragging then return end
		if not window.hidden or window.animating then
			dragging = false
			return
		end
		local mouse = UIS:GetMouseLocation()
		if not moved and (mouse - startMouse).Magnitude < threshold then return end
		moved = true
		local target = mouse + grab + inset()
		window.main.Position = UDim2.fromOffset(target.X, target.Y)
	end)
end

function W:Close()
	if self.unloaded or self.closing then return end
	self.closing = true
	self.animating = true
	local quick = Animator.presets.Quint_0_18
	self:_fadeSurfaces(false, quick)
	self:_fadeSearch(false, quick)
	Animator.play(bar.dragCosmetic, quick, {Size = UDim2.fromOffset(0, 4), BackgroundTransparency = 1})
	for _, el in page.elements do el:_setShown(false, true) end
	if self.title then Animator.play(self.title, quick, {TextTransparency = 1}) end
	if self.subtitle then Animator.play(self.subtitle, quick, {TextTransparency = 1}) end
	if self.topbarIcon then Animator.play(self.topbarIcon, quick, {ImageTransparency = 1}) end
	Animator.play(closeAction.iconLabel, quick, {ImageTransparency = 1})
	Animator.play(minimiseAction.iconLabel, quick, {ImageTransparency = 1})
	Animator.play(self.main, Animator.presets.ExpoInOut_0_35, {
		Size = UDim2.fromOffset(self.main.Size.X.Offset, 0), BackgroundTransparency = 1,
	})
	task.wait(0.4)
	self:Unload()
end

function W:Unload()
	if self.unloaded then return end
	self.unloaded = true
	pcall(function() audio:Stop() end)
	preview.video.Playing = false
	stopTrack()
	for _, object in spawned do pcall(function() object:Destroy() end) end
	spawned = {}
	Haptic.teardown()
	Haptic.releaseContainer(self.screenGui)
	for index = #renderer.connections, 1, -1 do
		pcall(function() renderer.connections[index]:Disconnect() end)
	end
	for index = #renderer.instances, 1, -1 do
		pcall(function() renderer.instances[index]:Destroy() end)
	end
	table.clear(renderer.connections)
	table.clear(renderer.instances)
	if registry.AssetViewerWindow == self then registry.AssetViewerWindow = nil end
end

registry.AssetViewerWindow = window
task.spawn(function() window:Show() end)

return window
