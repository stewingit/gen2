	window.bottomFadeCorner = WindowFrame.roundCorners(renderer, window.bottomFade, layout.fadeCorners)
	window.bottomFadeGradient = renderer:Create('UIGradient', {Rotation = S.fade.rotation, Offset = S.fade.offset, Transparency = layout.fadeTransparency, Parent = window.bottomFade}, {Color = {'WindowColor', function(color) return ColorSequence.new(colors.toColorSequence(color).Keypoints[1].Value) end}})
