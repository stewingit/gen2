if not isfolder(ROOT) then makefolder(ROOT) end

local function basename(path) return tostring(path):match('[^/\\]+$') or tostring(path) end
local function trim(text) return (text:match('^%s*(.-)%s*$')) end
local function cleanFolderName(text) return trim((text:gsub('[^%w%s]', ''))) end
local function cleanFileName(text) return trim((text:gsub('[^%w%s_]', ''))) end

local function getStartingIndex(path)
	local highest = 0
	local ok, files = pcall(listfiles, path)
	if ok then
		for _, file in files do
			local num = tonumber(basename(file):match('^(%d+)_'))
			if num and num > highest then highest = num end
		end
	end
	return highest
end

local function nextFolderName()
	local index = 1
	while isfolder(ROOT .. '/folder_' .. index) do index += 1 end
	return 'folder_' .. index
end

local showMenu, showFolder, refreshFolders, refreshFiles

local function refreshCurrent()
	if view == 'menu' then refreshFolders(if searchEl then searchEl.input.Text else '') else refreshFiles() end
end

local function clearRows()
	for _, row in rowObjs do mainW:RemoveRow(row) end
	table.clear(rowObjs)
end

local function clearStatic()
	for _, el in staticEls do mainW:RemoveElement(el) end
	table.clear(staticEls)
	searchEl, progress, backBtn = nil, nil, nil
end

local function notice(title, content)
	mainW:Popup{title = title, content = content, icon = ICON.Trash, options = {{text = 'Okay'}}}
end

local function openProject(name)
	projectName = ROOT .. '/' .. name
	pcall(makefolder, projectName)
	global_index = getStartingIndex(projectName)
	is_initialized = true
	showFolder()
end

