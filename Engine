-- Engine
local N = {}
local Runtime = {}
do
	local Node = {}
	local methods = {}
	Node.__index = function(self, key)
		local method = methods[key]
		if method ~= nil then return method end
		return rawget(self, '_children')[key]
	end
	Node.__tostring = function(self) return rawget(self, 'Name') end
	local realRequire = require

	function Runtime.attach(parent, node)
		node.Parent = parent
		parent._children[node.Name] = node
		table.insert(parent._list, node)
	end
	local function newNode(parent, name, className, fn)
		local node = setmetatable({Name = name, ClassName = className, _children = {}, _list = {}, _fn = fn, _state = 0}, Node)
		if parent then Runtime.attach(parent, node) end
		return node
	end
	function Runtime.folder(parent, name) return newNode(parent, name, 'Folder') end
	function Runtime.module(parent, name, fn) return newNode(parent, name, 'ModuleScript', fn) end

	function methods.FindFirstChild(self, name, recursive)
		local found = self._children[name]
		if found or not recursive then return found end
		for _, child in ipairs(self._list) do
			local deep = methods.FindFirstChild(child, name, true)
			if deep then return deep end
		end
		return nil
	end
	function methods.WaitForChild(self, name)
		local found = self._children[name]
		if not found then error(tostring(name) .. ' is not a child of ' .. self.Name, 2) end
		return found
	end
	function methods.GetChildren(self) return table.clone(self._list) end
	function methods.GetDescendants(self)
		local list = {}
		local function add(node) for _, child in ipairs(node._list) do list[#list + 1] = child add(child) end end
		add(self)
		return list
	end
	function methods.GetFullName(self)
		local parts, node = {}, self
		while node do table.insert(parts, 1, node.Name) node = node.Parent end
		return table.concat(parts, '.')
	end
	function methods.IsA(self, className)
		return className == self.ClassName or className == 'Instance' or (className == 'LuaSourceContainer' and self.ClassName == 'ModuleScript')
	end

	-- require for the bundled module tree (anything else goes to the real require)
	function Runtime.require(target)
		if getmetatable(target) ~= Node then return realRequire(target) end
		local state = target._state
		if state == 2 then return target._value end
		if state == 1 then error('cyclic require of ' .. methods.GetFullName(target), 2) end
		local fn = target._fn
		if not fn then error('cannot require a ' .. target.ClassName .. ' (' .. methods.GetFullName(target) .. ')', 2) end
		target._state = 1
		local ok, result = pcall(fn, target, Runtime.require)
		if not ok then target._state = 0 error(result, 0) end
		if result == nil then target._state = 0 error('module ' .. methods.GetFullName(target) .. ' did not return a value', 2) end
		target._value = result
		target._state = 2
		return result
	end
end

