registry.search = function(query)
	local assetId = tonumber(query) or tonumber(string.match(tostring(query), '%d+'))
	local results = {Success = false, Info = nil, Status = 'Error | Invalid ID'}
	if assetId then
		local ok, info = pcall(function() return MarketplaceService:GetProductInfo(assetId) end)
		if ok and info then
			local typeName = AssetTypes[info.AssetTypeId] or ('Type ID: ' .. tostring(info.AssetTypeId))
			results.Success = true
			results.Info = {
				Id = assetId,
				Name = info.Name,
				AssetType = info.AssetTypeId,
				TypeName = typeName,
				Creator = (info.Creator and info.Creator.Name) or 'Unknown',
			}
			results.Status = string.format('Found %s | %s', typeName, info.Name)
		else
			results.Status = 'Roblox Error | ID Not Found or Private'
		end
	end
	registry.LastSearch = results
	return results
end

