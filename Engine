function WindowFrame.notifications(renderer, window)
	local N = S.notifications
	local container = renderer:Create('Frame', {Name = N.name, Size = N.size, Position = N.position, AnchorPoint = Vector2.new(1, 1), BackgroundTransparency = 1, Parent = window.screenGui})
	renderer:Create('UIListLayout', {FillDirection = Enum.FillDirection.Vertical, VerticalAlignment = Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 0), Parent = container})
	return container
end

function WindowFrame.toasts(renderer, window, atTop)
	local T = S.toasts
	local container = renderer:Create('Frame', {Name = T.name, Size = UDim2.new(0, T.width, 1, T.heightInset), Position = if atTop then T.topPosition else T.bottomPosition, AnchorPoint = if atTop then Vector2.new(0.5, 0) else Vector2.new(0.5, 1), BackgroundTransparency = 1, ZIndex = Styles.Layers.zIndex.toast, Parent = window.screenGui})
	renderer:Create('UIListLayout', {FillDirection = Enum.FillDirection.Vertical, VerticalAlignment = if atTop then Enum.VerticalAlignment.Top else Enum.VerticalAlignment.Bottom, HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 0), Parent = container})
	return container
end

function WindowFrame.lockScrim(renderer, element)
	element.lockScrim = renderer:Create('TextButton', {Name = 'ElementLock', Active = true, AutoButtonColor = false, Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, Text = '', TextTransparency = 1, ZIndex = Styles.Layers.zIndex.elementLock, Visible = false, BackgroundTransparency = 1, Parent = element.main}, {BackgroundColor3 = {'WindowColor', firstColor}})
	renderer:Create('UICorner', {Parent = element.lockScrim}, {CornerRadius = 'ElementCornerRadius'})
end

return WindowFrame

end)
