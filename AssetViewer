function W:ClearLoaded()
	for _, tab in fileTabs do
		if tab.file then
			for _, object in tab.file.Children do pcall(function() object:Destroy() end) end
		end
	end
	fileTabs, openTabs = {}, {}
end

local function loadFromFile(path)
	local getAsset = getcustomasset or getsynasset
	if not getAsset then return nil, 'Your executor has no getcustomasset' end
	local ok, content = pcall(getAsset, path)
	if not ok or not content then return nil, 'getcustomasset could not read that file' end
	local loadedOk, objects = pcall(function() return game:GetObjects(content) end)
	if not (loadedOk and type(objects) == 'table' and #objects > 0) then
		local inserted, single = pcall(function() return game:GetService('InsertService'):LoadLocalAsset(content) end)
		if inserted and typeof(single) == 'Instance' then
			objects = {single}
		else
			return nil, 'GetObjects could not load that file'
		end
	end
	return objects
end

local function wireTab(tab)
	NavItem.build(renderer, tab, layout)
	local hit = tab.topbarItemInteract
	tab.connections = {
		renderer:Connect(hit.MouseButton1Click, function()
			if not window:_interactive() then return end
			Haptic.click()
			window:SelectTab(tab)
		end),
		renderer:Connect(hit.MouseEnter, function()
			if not window:_interactive() or window.selectedTab == tab then return end
			NavItem.applyVisual(tab, tabStates.hover, Styles.Page.tween.hover)
			Page.spinGradients(tab)
		end),
		renderer:Connect(hit.MouseLeave, function()
			if not window:_interactive() or window.selectedTab == tab then return end
			NavItem.applyVisual(tab, tabStates.unselected, Styles.Page.tween.hover)
		end),
	}
end

local function openFileTab(key, label, objects, path)
	fileCounter += 1
	local shortName = firstChars((label:gsub('%.rbxmx?$', '')), 10)
	local tab = {
		window = window, name = shortName, fullName = label, icon = 'file-box', customOrder = 10 + fileCounter,
		elements = {}, key = key,
		file = {Name = label, ClassName = 'File', Children = objects, Path = path},
	}
	table.insert(tabs, tab)
	Page.build(renderer, tab, window.elements)
	wireTab(tab)
	local b = newBrowser(tab, 'nodes')
	b.navStack = {tab.file}
	b.node = tab.file
	browserRefresh(b, true)
	openTabs[key] = tab
	table.insert(fileTabs, tab)
	if not window.hidden then
		tab.topbarItem.Visible = true
		NavItem.applyVisual(tab, tabStates.unselected, Styles.Page.tween.select)
	end
	window:SelectTab(tab)
end

closeFileTab = function(tab)
	if tab.closing then return end
	tab.closing = true
	openTabs[tab.key] = nil
	local index = table.find(fileTabs, tab)
	if index then table.remove(fileTabs, index) end
	if window.selectedTab == tab then window:SelectTab(loaderPage) end
	task.delay(0.4, function()
		if window.unloaded then return end
		local at = table.find(tabs, tab)
		if at then table.remove(tabs, at) end
		for _, object in tab.file.Children do pcall(function() object:Destroy() end) end
		for _, connection in tab.connections or {} do renderer:Disconnect(connection) end
		renderer:DestroySubtree(tab.topbarItem)
		renderer:DestroySubtree(tab.tabPage)
		tab.tabPage = nil
	end)
end

function W:Load(path)
	if not path or path == '' then return end
	local existing = openTabs[path]
	if existing and existing.tabPage then
		self:SelectTab(existing) -- already open: just go to it
		return
	end
	if loaderLoading then return end
	loaderLoading = true
	browserBusy(loaderBrowser, true, 'Loading...')
	task.spawn(function()
		local ok, objects, err = pcall(loadFromFile, path)
		loaderLoading = false
		browserBusy(loaderBrowser, false)
		if not ok then objects, err = nil, tostring(objects) end
		if window.unloaded then
			for _, object in objects or {} do pcall(function() object:Destroy() end) end
			return
		end
		if not objects then
			toast('Could not load', clip(err or 'Unknown error', 70))
			return
		end
		local label = path:match('([^/\\]+)$') or path
		openFileTab(path, label, objects, path)
		toast('Loaded', string.format('%s (%d root items)', clip(label, 30), #objects), 'check')
	end)
end

function W:Submit()
	if self.selectedTab == page then self:Search() end
end

function W:Choose(o)
	local options = {}
	for index, choice in o.choices do
		table.insert(options, {
			text = choice,
			style = if index == 1 then 'primary' else 'neutral',
			callback = function() o.callback(choice) end,
		})
	end
	table.insert(options, {text = 'Cancel'})
	return self:Popup({title = o.title, subtitle = o.subtitle, content = o.content, icon = o.icon or 'download', options = options})
end

local function baseNameFor(node, suffix)
	local name = (safeName(node.Name):gsub('%s+', '_'))
	if #name > 40 then name = name:sub(1, 40) end
	return name .. '_' .. tostring(suffix or node.ClassName)
end

local function saveData(node, suffix, ext, data)
	ensureFolder()
	local path = string.format('%s/%s%s', DOWNLOAD_FOLDER, baseNameFor(node, suffix), ext)
	if pcall(writefile, path, data) then
		toast('Saved to files', path, 'check')
		return path
	end
	toast('Download failed', 'Could not write the file')
	return nil
end

local function saveInstanceTo(node, path, binary)
	if type(saveinstance) ~= 'function' then return false end
	local options = {
		Binary = binary, IsModel = true, FilePath = path, FileName = path, Object = node,
		ExtraInstances = {node}, mode = 'optimized', SaveNonCreatable = false,
	}
	local attempts = {
		function() return saveinstance(node, path, options) end,
		function() return saveinstance(options) end,
	}
	for _, attempt in attempts do
		pcall(attempt)
		local ok, exists = pcall(isfile, path)
		if ok and exists then return true end
	end
	return false
end

local function copyText(text, label)
	local clip_ = setclipboard or toclipboard
	if not clip_ then
		toast('No clipboard support', 'Your executor lacks setclipboard')
		return
	end
	if pcall(clip_, text) then
		toast('Copied ' .. label, clip(text, 40), 'check')
	else
		toast('Copy failed', 'The clipboard rejected the text')
	end
end

local function downloadScript(node, b)
	browserBusy(b, true, 'Reading script...')
	task.spawn(function()
		local source = getSource(node)
		browserBusy(b, false)
		if not source then
			toast('Could not read source', 'Your executor needs decompile or a readable Source')
			return
		end
		window:Choose({
			title = 'Save script as',
			subtitle = node.Name,
			content = string.format('%d characters. The file is saved exactly as shown in the preview. Pick a file type:', #source),
			choices = {'.lua', '.txt', '.luau'},
			callback = function(ext) saveData(node, node.ClassName, ext, source) end,
		})
	end)
end

local function downloadAsset(node, kind, prop, b)
	local id = parseAssetId(propValue(node, prop))
	if not id then
		toast('No asset ID', prop .. ' is empty or points at a local file')
		return
	end
	browserBusy(b, true, 'Downloading...')
	task.spawn(function()
		local data = if kind == 'image' then fetchImage(id) else fetchAsset(id)
		browserBusy(b, false)
		if not data then
			toast('Download denied', 'That asset is private, protected or unavailable')
			return
		end
		local detected, label = sniff(data)
		local choices, seen = {}, {}
		local function push(ext)
			if ext and not seen[ext] and #choices < 3 then
				seen[ext] = true
				table.insert(choices, ext)
			end
		end
		push(detected)
		for _, ext in FORMAT_CHOICES[kind] do push(ext) end
		window:Choose({
			title = 'Save ' .. kind .. ' as',
			subtitle = node.Name,
			content = string.format('Detected: %s (%d KB). Choosing a different extension only renames the file, it does not convert it.',
				label or 'unknown format', math.max(1, math.floor(#data / 1024))),
			choices = choices,
			callback = function(ext) saveData(node, id, ext, data) end,
		})
	end)
end

local function downloadInstance(node, b)
	if type(saveinstance) ~= 'function' then
		toast('No saveinstance support', 'Your executor cannot save models or parts')
		return
	end
	window:Choose({
		title = 'Save as',
		subtitle = node.Name,
		content = 'Saves this item and everything inside it using your executor\'s saveinstance.',
		choices = {'.rbxm', '.rbxmx'},
		callback = function(ext)
			browserBusy(b, true, 'Saving...')
			task.spawn(function()
				ensureFolder()
				local path = string.format('%s/%s%s', DOWNLOAD_FOLDER, baseNameFor(node, node.ClassName), ext)
				local saved = saveInstanceTo(node, path, ext == '.rbxm')
				browserBusy(b, false)
				if saved then
					toast('Saved to files', path, 'check')
				else
					toast('Save failed', 'saveinstance did not produce a file')
				end
			end)
		end,
	})
end

function W:DownloadNode(node, b)
	if not writefile then
		toast('No writefile support', 'Your executor cannot save files')
		return
	end
	local kind, prop = classify(node)
	if kind == 'script' then
		downloadScript(node, b)
	elseif prop and parseAssetId(propValue(node, prop)) then
		downloadAsset(node, kind, prop, b)
	else
		downloadInstance(node, b)
	end
end

function W:CopyNode(node, b)
	local kind, prop = classify(node)
	local rootName = b.tab.file.Name
	local choices
	if kind == 'script' then
		choices = {'Source', 'Path'}
	elseif prop and parseAssetId(propValue(node, prop)) then
		choices = {'Asset ID', 'Path'}
	else
		choices = {'Name', 'Path'}
	end
	window:Choose({
		title = 'Copy what?',
		subtitle = node.Name,
		choices = choices,
		icon = 'copy',
		callback = function(choice)
			task.spawn(function()
				if choice == 'Source' then
					local source = getSource(node)
					if source then copyText(source, 'source') else toast('Could not read source', 'Your executor needs decompile') end
				elseif choice == 'Asset ID' then
					copyText(tostring(parseAssetId(propValue(node, prop))), 'asset ID')
				elseif choice == 'Name' then
					copyText(node.Name, 'name')
				else
					copyText(pathOf(node, rootName), 'path')
				end
			end)
		end,
	})
end

function W:SpawnNode(node)
	local cf = spawnCFrame()
	if not cf then return end
	local ok, clone = pcall(function() return node:Clone() end)
	if not ok or not clone then
		toast('Could not spawn', 'This item cannot be cloned')
		return
	end
	pcall(function() clone:PivotTo(cf) end)
	clone.Parent = workspace
	track(clone)
	toast('Spawned ' .. clip(node.Name, 24), nil, 'check')
end

function W:NodeMenu(node, b)
	if typeof(node) ~= 'Instance' then return end
	local kind, prop = classify(node)
	local rootName = b.tab.file.Name
	browserBusy(b, true, 'Reading...')
	task.spawn(function()
		local lines = {'Class: ' .. node.ClassName, 'Path: ' .. pathOf(node, rootName)}
		local kids = #nodeChildren(node)
		if kids > 0 then table.insert(lines, 'Children: ' .. kids) end
		if prop then
			local value = propValue(node, prop)
			if value then table.insert(lines, prop .. ': ' .. value) end
		end
		if kind == 'script' then
			local source = getSource(node)
			if source then
				local lineCount = select(2, source:gsub('\n', '\n')) + 1
				table.insert(lines, string.format('Source: %d lines, %d characters', lineCount, #source))
				table.insert(lines, '')
				table.insert(lines, sourcePreview(source))
			else
				table.insert(lines, 'Source: not readable (your executor needs decompile)')
			end
		end
		browserBusy(b, false)
		if window.unloaded then return end

		local options = {
			{text = 'Download', style = 'primary', callback = function() window:DownloadNode(node, b) end},
			{text = 'Copy', callback = function() window:CopyNode(node, b) end},
		}
		if node:IsA('PVInstance') then
			table.insert(options, {text = 'Spawn', callback = function() window:SpawnNode(node) end})
		end
		table.insert(options, {text = 'Cancel'})
		window:Popup({
			title = clip(node.Name, 60),
			subtitle = node.ClassName,
			content = table.concat(lines, '\n'),
			icon = KIND_ICONS[kind] or 'box',
			options = options,
		})
	end)
end

function W:SelectTab(tab)
	if self.unloaded or not tab or not tab.tabPage or tab == self.selectedTab then return end
	local previous = self.selectedTab
	if previous then previous.searchText = self.searchInput.Text end
	self.selectedTab = tab
	self.elementsLayout:JumpTo(tab.tabPage)
	self.searchInput.PlaceholderText = tab.placeholder or ''
	self.searchInput.Text = tab.searchText or ''
	self.searchPill.Visible = tab == page and not self.hidden
	self.elements.Size = UDim2.new(1, 0, 1, -(if tab == page then layout.chromeHeight else NO_SEARCH_CHROME))
	for _, other in tabs do
		NavItem.applyVisual(other, tabStates[if other == tab then 'selected' else 'unselected'], Styles.Page.tween.select)
	end
	Page.spinGradients(tab)
	if tag then Pill.setShown(tag, tab == page, true) end
	if tab == loaderPage then browserRefresh(loaderBrowser, false) end
end

page.placeholder = 'Enter a Roblox asset ID'

for _, tab in tabs do wireTab(tab) end

browserRefresh(loaderBrowser, false)


do
	local dragging, grab = false, Vector2.zero
	local style = Styles.DragBar

	local function inset()
		if window.screenGui.IgnoreGuiInset then return variables.guiService:GetGuiInset() end
		return Vector2.zero
	end

	local function target()
		local point = UIS:GetMouseLocation() + grab + inset()
		local x, y = point.X, point.Y
		if window.settings.keepOnScreen then
			local mainSize, screenSize, margin = window.main.AbsoluteSize, window.screenGui.AbsoluteSize, style.screenMargin
			local halfX, halfY = mainSize.X / 2, mainSize.Y / 2
			x = math.clamp(x, halfX + margin, math.max(halfX + margin, screenSize.X - halfX - margin))
			y = math.clamp(y, halfY + margin, math.max(halfY + margin, screenSize.Y - halfY - margin))
		end
		return UDim2.fromOffset(x, y), UDim2.fromOffset(x, y + window.main.Size.Y.Offset / 2 + style.gap)
	end

	local function isPress(input)
		local name = input.UserInputType.Name
		return name == 'MouseButton1' or name == 'Touch'
	end

	local function begin()
		if not window:_interactive() then return end
		dragging = true
		grab = window.main.AbsolutePosition + window.main.AbsoluteSize * window.main.AnchorPoint - UIS:GetMouseLocation()
		DragBar.press(bar)
	end

	local function finish()
		if not dragging then return end
		dragging = false
		if window.unloaded or not window:_interactive() then return end
		local mainPosition, barPosition = target()
		DragBar.release(bar, mainPosition, barPosition)
	end

	local function overActions(position)
		local at, size = window.actionContainer.AbsolutePosition, window.actionContainer.AbsoluteSize
		return position.X >= at.X and position.X <= at.X + size.X and position.Y >= at.Y and position.Y <= at.Y + size.Y
	end

	renderer:Connect(window.topbar.InputBegan, function(input, processed)
		if processed or not isPress(input) then return end
		if overActions(input.Position) then return end
		begin()
	end)
	renderer:Connect(bar.dragInteract.InputBegan, function(input, processed)
		if processed or not isPress(input) then return end
		begin()
	end)
	renderer:Connect(bar.dragInteract.MouseEnter, function()
		if not dragging and not window.hidden then DragBar.hover(bar, true) end
	end)
	renderer:Connect(bar.dragInteract.MouseLeave, function()
		if not dragging and not window.hidden then DragBar.hover(bar, false) end
	end)
	renderer:Connect(UIS.InputEnded, function(input)
		if isPress(input) then finish() end
	end)
	renderer:Connect(UIS.WindowFocusReleased, finish)
	renderer:Connect(variables.runService.RenderStepped, function(dt)
		if not dragging then return end
		if not window:_interactive() then
			dragging = false
			return
		end
		local mainPosition, barPosition = target()
		DragBar.follow(bar, mainPosition, barPosition, dt)
	end)
end

function W:_syncDragBar()
	local position = self.main.Position
	bar.drag.Position = UDim2.new(position.X.Scale, position.X.Offset, position.Y.Scale, position.Y.Offset + self.size.Y.Offset / 2 + Styles.DragBar.gap)
end

do
	local acc = 0
	renderer:Connect(variables.runService.Heartbeat, function(dt)
		acc += dt
		if acc < 0.5 or window.unloaded then return end
		acc = 0
		local newSize = fitSize()
		if newSize ~= window.size then
			window.size = newSize
			if not (window.hidden or window.animating) then
				window.main.Size = newSize
				window:_syncDragBar()
			end
		end
	end)
end

function W:_revealAll(step)
	local selected = self.selectedTab or page
	for _, tab in tabs do
		if tab ~= selected then
			for _, el in tab.elements do el:_setShown(true, false) end
		end
	end
	for index, el in ipairs(selected.elements) do
		el:_setShown(true, true)
		if step and index <= 14 then task.wait(step) end
	end
end

function W:_hideAll()
	local selected = self.selectedTab or page
	for _, tab in tabs do
		for _, el in tab.elements do el:_setShown(false, tab == selected) end
	end
end

function W:_clampedPosition(position)
	if not self.settings.keepOnScreen then return position end
	if position.X.Scale ~= 0 or position.Y.Scale ~= 0 then return position end
	local screen, halfX, halfY, margin = self.screenGui.AbsoluteSize, self.size.X.Offset / 2, self.size.Y.Offset / 2, 8
	local x = math.clamp(position.X.Offset, halfX + margin, math.max(halfX + margin, screen.X - halfX - margin))
	local y = math.clamp(position.Y.Offset, halfY + margin, math.max(halfY + margin, screen.Y - halfY - margin))
	return UDim2.fromOffset(x, y)
end

local COLLAPSED_SIZE = UDim2.fromOffset(185, 50)
local COLLAPSED_ICON_SIZE = UDim2.fromOffset(50, 50)
local COLLAPSED_BASE = UDim2.new(0.5, 0, 0, 20)

function W:_collapsedRect()
	local size = if self.showIconOnly then COLLAPSED_ICON_SIZE else COLLAPSED_SIZE
	if self._collapsedPosition then return self._collapsedPosition, size end
	return UDim2.new(COLLAPSED_BASE.X.Scale, COLLAPSED_BASE.X.Offset, COLLAPSED_BASE.Y.Scale, COLLAPSED_BASE.Y.Offset + size.Y.Offset / 2), size
end

function W:_revealChrome(info)
	if self.topbarIcon then Animator.play(self.topbarIcon, info, {ImageTransparency = 0}) end
	if self.title then Animator.play(self.title, info, {TextTransparency = 0}) end
	if self.subtitle then Animator.play(self.subtitle, info, {TextTransparency = 0.7}) end
	IconButton.fade(closeAction, 'rest')
	IconButton.fade(minimiseAction, 'rest')
	if tag then Pill.setShown(tag, self.selectedTab == page, true) end
	for _, tab in tabs do
		tab.topbarItem.Visible = true
		NavItem.applyVisual(tab, tabStates[if tab == self.selectedTab then 'selected' else 'unselected'], info)
		Page.spinGradients(tab)
	end
end

function W:Show()
	if self.animating or not self.hidden then return end
	self.animating = true
	self.hidden = false
	self.collapsedInteract.Visible = false
	if self.hasShownOnce then
		self:_restore()
	else
		self.hasShownOnce = true
		self:_firstShow()
	end
end

function W:_firstShow()
	self.main.Visible = true
	bar.drag.Visible = false

	Animator.play(self.main, Animator.presets.ExpoInOut_1, {BackgroundTransparency = 0, Size = self.size})
	task.wait(0.85)
	if self.unloaded then return end
	self:_fadeSurfaces(true, Animator.presets.Expo_0_6)
	task.wait(0.3)
	if self.unloaded then return end

	self:_revealChrome(Animator.presets.Expo_0_4)
	self:_fadeSearch(true, Animator.presets.Quint_0_4)
	task.wait(0.2)

	self:_revealAll(0.03)
	task.wait(0.5)
	if self.unloaded then return end

	self:_syncDragBar()
	bar.drag.Visible = true
	Animator.play(bar.dragCosmetic, Animator.presets.Expo_0_6, {BackgroundTransparency = 0.7})
	Animator.play(bar.dragCosmetic, Animator.presets.Expo_1, {Size = UDim2.fromOffset(100, 4)})
	self.animating = false
end

function W:Hide()
	if self.animating or self.hidden then return end
	self.animating = true
	self.hidden = true
	self.collapsedInteract.Visible = false
	self._restorePosition = self.main.Position

	local position, size = self:_collapsedRect()
	local fast, move, fade = Animator.presets.Quint_0_18, Animator.presets.ExpoInOut_0_35, Animator.presets.Quint_0_2

	Animator.play(bar.dragCosmetic, fast, {Size = UDim2.fromOffset(0, 4), BackgroundTransparency = 1})
	task.delay(0.18, function()
		if self.hidden and not self.unloaded then bar.drag.Visible = false end
	end)
	self:_fadeSurfaces(false, fast)
	self:_fadeSearch(false, fast)
	if self.title then Animator.play(self.title, fast, {TextTransparency = 1}) end
	if self.subtitle then Animator.play(self.subtitle, fast, {TextTransparency = 1}) end
	if self.topbarIcon then Animator.play(self.topbarIcon, fast, {ImageTransparency = 1}) end
	Animator.play(closeAction.iconLabel, fast, {ImageTransparency = 1})
	Animator.play(minimiseAction.iconLabel, fast, {ImageTransparency = 1})
	if tag then Pill.setShown(tag, false, true) end
	for _, tab in tabs do NavItem.applyVisual(tab, tabStates.hidden, fast) end
	self:_hideAll()

	local tween = Animator.play(self.main, move, {Size = size, Position = position})
	tween.Completed:Connect(function()
		if self.unloaded or not self.hidden then return end
		self.collapsedInteract.Visible = true
		self.animating = false
	end)
	Animator.play(self.windowCorner, move, {CornerRadius = UDim.new(1, 0)})
	task.delay(0.18, function()
		if not self.hidden or self.unloaded then return end
		self.topbar.Visible = false
		self.elements.Visible = false
		self.tabList.Visible = false
		self.searchPill.Visible = false
		CollapsedFace.setShown(self, true, fade)
	end)
end

function W:_restore()
	local position = self:_clampedPosition(self._restorePosition or UDim2.new(0.5, 0, 0.5, 0))
	self._restorePosition = position
	local move, fade = Animator.presets.ExpoInOut_0_35, Animator.presets.Expo_0_28

	CollapsedFace.setShown(self, false, Animator.presets.Quint_0_15)
	Animator.play(self.main, move, {Size = self.size, Position = position})
	Animator.play(self.windowCorner, move, {CornerRadius = self.theme.CornerRoundness})

	task.delay(0.22, function()
		if self.hidden or self.unloaded then return end
		self.topbar.Visible = true
		self.elements.Visible = true
		self.tabList.Visible = true
		self.searchPill.Visible = self.selectedTab == page
		self:_fadeSurfaces(true, fade)
		self:_revealChrome(fade)
		self:_fadeSearch(true, Animator.presets.Quint_0_4)
		task.spawn(function() self:_revealAll(0.035) end)
		bar.drag.Position = UDim2.new(position.X.Scale, position.X.Offset, position.Y.Scale, position.Y.Offset + self.size.Y.Offset / 2 + Styles.DragBar.gap)
		bar.dragCosmetic.Size = UDim2.fromOffset(0, 4)
		bar.dragCosmetic.BackgroundTransparency = 1
		bar.drag.Visible = true
		Animator.play(bar.dragCosmetic, Animator.presets.Expo_0_6, {BackgroundTransparency = 0.7, Size = UDim2.fromOffset(100, 4)})
	end)
	task.delay(0.6, function() self.animating = false end)
end

function W:ToggleHide()
	if self.animating or self.unloaded then return end
	if self.hidden then self:Show() else self:Hide() end
end

do
	local dragging, moved, grab, startMouse = false, false, Vector2.zero, Vector2.zero
	local threshold = Styles.Collapsed.dragThreshold

	local function inset()
		if window.screenGui.IgnoreGuiInset then return variables.guiService:GetGuiInset() end
		return Vector2.zero
	end
	local function isPress(input)
		local name = input.UserInputType.Name
		return name == 'MouseButton1' or name == 'Touch'
	end

	renderer:Connect(window.collapsedInteract.InputBegan, function(input, processed)
		if processed or not window.hidden or window.animating or not isPress(input) then return end
		dragging, moved = true, false
		startMouse = UIS:GetMouseLocation()
		grab = window.main.AbsolutePosition + window.main.AbsoluteSize * window.main.AnchorPoint - startMouse
	end)
	renderer:Connect(UIS.InputEnded, function(input)
		if not isPress(input) or not dragging then return end
		dragging = false
		if moved then
			window._collapsedPosition = window.main.Position
			return
		end
		Haptic.click()
		window:ToggleHide()
	end)
	renderer:Connect(UIS.WindowFocusReleased, function() dragging = false end)
	renderer:Connect(variables.runService.RenderStepped, function()
		if not dragging then return end
		if not window.hidden or window.animating then
			dragging = false
			return
		end
		local mouse = UIS:GetMouseLocation()
		if not moved and (mouse - startMouse).Magnitude < threshold then return end
		moved = true
		local target = mouse + grab + inset()
		window.main.Position = UDim2.fromOffset(target.X, target.Y)
	end)
end

function W:Close()
	if self.unloaded or self.closing then return end
	self.closing = true
	self.animating = true
	local quick = Animator.presets.Quint_0_18
	self:_fadeSurfaces(false, quick)
	self:_fadeSearch(false, quick)
	Animator.play(bar.dragCosmetic, quick, {Size = UDim2.fromOffset(0, 4), BackgroundTransparency = 1})
	for _, tab in tabs do NavItem.applyVisual(tab, tabStates.hidden, quick) end
	self:_hideAll()
	if self.title then Animator.play(self.title, quick, {TextTransparency = 1}) end
	if self.subtitle then Animator.play(self.subtitle, quick, {TextTransparency = 1}) end
	if self.topbarIcon then Animator.play(self.topbarIcon, quick, {ImageTransparency = 1}) end
	Animator.play(closeAction.iconLabel, quick, {ImageTransparency = 1})
	Animator.play(minimiseAction.iconLabel, quick, {ImageTransparency = 1})
	Animator.play(self.main, Animator.presets.ExpoInOut_0_35, {
		Size = UDim2.fromOffset(self.main.Size.X.Offset, 0), BackgroundTransparency = 1,
	})
	task.wait(0.4)
	self:Unload()
end

function W:Unload()
	if self.unloaded then return end
	self.unloaded = true
	pcall(function() audio:Stop() end)
	preview.video.Playing = false
	stopTrack()
	for _, object in spawned do pcall(function() object:Destroy() end) end
	spawned = {}
	if self.ClearLoaded then self:ClearLoaded() end
	Haptic.teardown()
	Haptic.releaseContainer(self.screenGui)
	for index = #renderer.connections, 1, -1 do
		pcall(function() renderer.connections[index]:Disconnect() end)
	end
	for index = #renderer.instances, 1, -1 do
		pcall(function() renderer.instances[index]:Destroy() end)
	end
	table.clear(renderer.connections)
	table.clear(renderer.instances)
	if registry.AssetViewerWindow == self then registry.AssetViewerWindow = nil end
end

registry.AssetViewerWindow = window
task.spawn(function() window:Show() end)

return window
