-- One hint per window; it follows whichever tab is currently selected.
local function createHint(renderer, window)
	local parent = window.bottomFade or window.main
	local holder = renderer:Create('Frame', {Name = 'ScrollHint', AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -H.bottomOffset), Size = H.size, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = H.zIndex, Parent = parent})
