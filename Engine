N['Engine/Core/ThemeManager'] = Runtime.module(N['Engine/Core'], 'ThemeManager', function(script, require)
local variables = require(script.Parent.StateManager.variables)
local log = require(script.Parent.Utilities.log)

local ThemeManager = {}
ThemeManager.__index = ThemeManager
ThemeManager.themes = script.Parent.Parent.Themes

local SEQUENCE_KEYS = {
	WindowColor = true, ElementGradient = true, ElementStrokeGradient = true,
	TabBackground = true, TabStroke = true, SliderProgress = true,
}
local Animator = require(script.Parent.Animator)
local APPLY_TWEEN = Animator.presets.Quint_0_5

function ThemeManager.normalize(key, value)
	if SEQUENCE_KEYS[key] and typeof(value) == "Color3" then return ColorSequence.new(value) end
	return value
end

local function firstColor(value)
	return if typeof(value) == "ColorSequence" then value.Keypoints[1].Value else value
end

local function contrastLerp(color, amount)
	local luminance = 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
	local target = if luminance > 0.5 then Color3.new(0, 0, 0) else Color3.new(1, 1, 1)
	return color:Lerp(target, amount)
end

function ThemeManager.derive(theme, given)
	if given.ElementGradient then
		local base = firstColor(theme.ElementGradient)
		if given.ElementStroke == nil then theme.ElementStroke = contrastLerp(base, 0.28) end
		if given.ElementStrokeGradient == nil then theme.ElementStrokeGradient = ColorSequence.new(contrastLerp(base, 0.4)) end
		if given.ElementStrokeHover == nil then theme.ElementStrokeHover = contrastLerp(base, 0.52) end
	end
	if given.TabBackground and given.TabStroke == nil then
		theme.TabStroke = ColorSequence.new(contrastLerp(firstColor(theme.TabBackground), 0.4))
	end
end

function ThemeManager.resolve(spec, label)
	label = label or "Engine"
	if typeof(spec) == "table" then
		return spec
	elseif typeof(spec) == "string" then
		local module = ThemeManager.themes:FindFirstChild(string.lower(spec))
		if module then return require(module) end
		log.warn(label .. ": unknown theme '" .. spec .. "', using default")
	elseif spec ~= nil then
		log.warn(label .. ": invalid theme (expected a built-in name or a theme table), using default")
	end
	return require(ThemeManager.themes.default)
end

function ThemeManager.build(spec, label)
	local theme, source = table.clone(require(ThemeManager.themes.default)), ThemeManager.resolve(spec, label)
	for key, value in source do theme[key] = ThemeManager.normalize(key, value) end
	if typeof(spec) == "table" then ThemeManager.derive(theme, source) end
	local given = if typeof(spec) == "table" then spec else nil
	if not (given and (given.Font or given.font)) then theme.Font = variables.brandFont(Enum.FontWeight.Medium) end
	if not (given and (given.TitleFont or given.titleFont)) then theme.TitleFont = variables.brandFont(Enum.FontWeight.SemiBold) end
	return theme
end

local function valueFor(theme, key)
	return if typeof(key) == "table" then key[2](theme[key[1]]) else theme[key]
end

function ThemeManager.bindInstance(theme, bindings, instance, props)
	for property, key in props do instance[property] = valueFor(theme, key) end
	bindings[instance] = props
end

function ThemeManager.apply(theme, bindings)
	for instance, props in bindings do
		for property, key in props do
			local value = valueFor(theme, key)
			if typeof(value) == "Color3" or typeof(value) == "number" then
				Animator.play(instance, APPLY_TWEEN, {[property] = value})
			else
				instance[property] = value
			end
		end
	end
end

function ThemeManager.change(theme, bindings, spec, label)
	local incoming = if typeof(spec) == "table" then spec else ThemeManager.build(spec, label)
	for key, value in incoming do theme[key] = ThemeManager.normalize(key, value) end
	if typeof(spec) == "table" then ThemeManager.derive(theme, incoming) end
	ThemeManager.apply(theme, bindings)
end

function ThemeManager.new(opts)
	opts = opts or {}
	local self = setmetatable({label = opts.label, bindings = {}}, ThemeManager)
	self.theme = ThemeManager.build(opts.theme, self.label)
	return self
end

function ThemeManager:bind(instance, props)
	ThemeManager.bindInstance(self.theme, self.bindings, instance, props)
end

function ThemeManager:SetTheme(spec)
	ThemeManager.change(self.theme, self.bindings, spec, self.label)
end

function ThemeManager:Get()
	return self.theme
end

return ThemeManager

end)
