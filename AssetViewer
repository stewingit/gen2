local function guarded(el, fn, ...)
	if not fn then return end
	local args = table.pack(...)
	task.spawn(function()
		local ok, err = pcall(fn, table.unpack(args, 1, args.n))
		if not ok then
			log.warn("Asset Viewer: callback for '" .. tostring(el and el.name) .. "' errored:")
			log.print(err)
			window:Toast({title = 'Something went wrong', subtitle = tostring(err):sub(1, 60), icon = 'x'})
		end
	end)
end

local function add(parent, el)
	table.insert(parent.elements, el)
	local order = #parent.elements * 10
	el.main.LayoutOrder = order
	if el.descriptor then el.descriptor.main.LayoutOrder = order + 1 end
	if parent.compact and parent.direction then
		Stack.wrapChild(parent, el)
		Stack.reflow(parent)
	end
	if not window.hidden then el:_setShown(true, true) end
	return el
end

local function Descriptor_(parent, text)
	local d = {tab = parent, window = window, description = text, __type = 'Descriptor'}
	Caption.build(renderer, d)
	return d
end

local function Heading_(parent, name, icon)
	local el = {tab = parent, window = window, name = name, icon = icon, __type = 'Section'}
	Heading.build(renderer, el)
	function el:_setShown(shown, animate)
		reveal(self.title, {TextTransparency = if shown then Styles.Section.title.shownTransparency else 1}, animate)
		if self.iconLabel then
			reveal(self.iconLabel, {ImageTransparency = if shown then Styles.Section.icon.shownTransparency else 1}, animate)
		end
	end
	return add(parent, el)
end

local function Button_(parent, o)
	local el = {
		tab = parent, window = window, name = o.name, icon = o.icon, description = o.description,
		compact = parent.compact or false, callback = o.callback, __type = 'Button',
	}
	local function press() guarded(el, el.callback) end
	if el.compact then
		ButtonBase.buildCompact(renderer, el, press)
	else
		ButtonBase.buildFull(renderer, el, press)
	end
	if el.description and not el.compact then el.descriptor = Descriptor_(parent, el.description) end
	function el:_setShown(shown, animate)
		if shown then window:_revealCommon(self, animate) else window:_hideCommon(self, animate) end
	end
	function el:_minWidth()
		local width = 32
		if self.icon then width += 22 end
		return width + functions.textWidth(window.theme.Font, 16, locale.resolve(self.name))
	end
	function el:SetText(text)
		self.name = text
		self.title.Text = text
	end
	function el:SetIcon(icon)
		self.icon = icon
		if self.iconLabel then renderer.assign(self.iconLabel, 'Image', icon) end
	end
	function el:SetVisible(visible) self.main.Visible = visible end
	return add(parent, el)
end

local function Group_(parent)
	local el = {tab = parent, window = window, direction = Enum.FillDirection.Horizontal, compact = true, elements = {}, __type = 'Group'}
	Stack.build(renderer, el, parent.direction == Enum.FillDirection.Horizontal)
	function el:_setShown(shown, animate)
		for _, child in self.elements do child:_setShown(shown, animate) end
	end
	table.insert(parent.elements, el)
	el.main.LayoutOrder = #parent.elements * 10
	return el
end

local function Text_(parent, o)
	local el = {tab = parent, window = window, name = o.name or '', text = o.text or '', icon = o.icon, __type = 'Text'}
	Paragraph.build(renderer, el)
	function el:_setShown(shown, animate)
		if shown then window:_revealCommon(self, animate) else window:_hideCommon(self, animate) end
		reveal(self.body, {TextTransparency = if shown then Styles.Paragraph.body.shownTransparency else 1}, animate)
	end
	function el:Set(text) Paragraph.setText(renderer, self, text) end
	function el:SetTitle(name) Paragraph.setTitle(renderer, self, name) end
	return add(parent, el)
end

local function Toggle_(parent, o)
	local T = Styles.Toggle
	local el = {
		tab = parent, window = window, name = o.name, icon = o.icon, description = o.description,
		value = o.value == true, callback = o.callback, __type = 'Toggle',
	}
	local function perform()
		el.value = not el.value
		Switch.animate(renderer, el)
		guarded(el, el.callback, el.value)
	end
	ButtonBase.buildFull(renderer, el, perform, {
		style = T.full,
		press = T.press,
		control = function()
			Switch.build(renderer, el, el.main, function(...) return renderer:CreateGlow(...) end)
			el.functionContainer.Position = T.full.switchPosition
			el.functionContainer.AnchorPoint = T.full.switchAnchor
		end,
	})
	if el.description then el.descriptor = Descriptor_(parent, el.description) end
	function el:_setShown(shown, animate)
		if shown then window:_revealCommon(self, animate) else window:_hideCommon(self, animate) end
		Switch.setShown(function(instance, goals, a, tween) reveal(instance, goals, a, tween) end, renderer, self, shown, animate)
	end
	return add(parent, el)
end

local function Progress_(parent, o)
	local P = Styles.Progress
	local el = {
		tab = parent, window = window, name = o.name, icon = o.icon, min = 0, max = 1, value = 0,
		showValue = o.showValue ~= false, indeterminate = false, text = o.text, __type = 'Progress',
	}
	function el:_clamp(v) return math.clamp(tonumber(v) or self.min, self.min, self.max) end
	function el:_ratio()
		local span = self.max - self.min
		if span <= 0 then return 0 end
		return (self.value - self.min) / span
	end
	function el:_readout()
		if self.text then return locale.resolve(self.text) end
		return string.format('%d%%', math.round(self:_ratio() * 100))
	end
	ProgressBar.build(renderer, el, function(...) return renderer:CreateGlow(...) end)
	function el:_setShown(shown, animate)
		self._shown = shown
		reveal(self.readout, {TextTransparency = if shown then P.readout.shownTransparency else 1}, animate)
		if shown then window:_revealCommon(self, animate) else window:_hideCommon(self, animate) end
		reveal(self.track, {BackgroundTransparency = if shown then 0 else 1}, animate)
		reveal(self.fill, {BackgroundTransparency = if shown then 0 else 1}, animate)
		reveal(self.fillGlow, {Transparency = if shown then window.theme.AccentGlow else 1}, animate)
	end
	function el:Set(value)
		self.value = self:_clamp(value)
		if self.indeterminate then
			self.indeterminate = false
			ProgressBar.stopSweep(self)
		end
		ProgressBar.render(self, true)
	end
	function el:SetRange(min, max)
		self.min, self.max = min, math.max(max, min)
		self.value = self:_clamp(self.value)
	end
	function el:SetText(text)
		self.text = text
		ProgressBar.refreshReadout(self)
	end
	function el:SetTitle(text)
		self.name = text
		self.title.Text = text
	end
	function el:SetIndeterminate(on)
		on = on == true
		if on == self.indeterminate then return end
		self.indeterminate = on
		if on then
			ProgressBar.startSweep(self)
		else
			ProgressBar.stopSweep(self)
			ProgressBar.render(self, false)
		end
	end
	return add(parent, el)
end

function W:Toast(o)
	if self.unloaded then return end
	o = if typeof(o) == 'table' then o else {}
	local t = {
		window = self, title = o.title or '', subtitle = o.subtitle, icon = o.icon, minWidth = o.minWidth,
		subtitleAbove = false, position = 'Top', isAvatar = false, _hovered = false, _dismissed = false,
	}
	t.duration = o.duration or math.clamp(#(t.title .. (t.subtitle or '')) * 0.06 + 3, 3, 9)
	t.hasIcon = t.icon ~= nil and t.icon ~= 0 and t.icon ~= ''
	t._iconImage = if t.hasIcon then (if type(t.icon) == 'number' then 'rbxassetid://' .. t.icon else t.icon) else nil

	if not self._toastsTop then self._toastsTop = WindowFrame.toasts(renderer, self, true) end
	Toast.build(renderer, t, self._toastsTop)

	self._toastCount = (self._toastCount or 0) + 1
	t.main.LayoutOrder = -self._toastCount
	self._liveToasts = self._liveToasts or {}
	t._live = self._liveToasts
	table.insert(t._live, t)
	while #t._live > Styles.Toast.maxLive do
		local oldest = table.remove(t._live, 1)
		if oldest and oldest ~= t then task.spawn(oldest._dismiss, oldest) end
	end

	function t:_measure() return Toast.measure(renderer, self) end
	function t:_show() Toast.show(renderer, self) end
	function t:_dismiss() Toast.dismiss(renderer, self, self._live) end
	Toast.start(renderer, t)
	return t
end

local popupStack = {}

function W:Popup(o)
	if self.unloaded then return end
	o = if typeof(o) == 'table' then o else {}
	local p = {
		window = self, title = o.title or 'Popup', subtitle = o.subtitle, content = o.content, icon = o.icon,
		options = o.options or {{text = 'Okay'}}, dismissable = o.dismissable ~= false,
		_reveal = {}, _connections = {}, _closed = false,
	}
	function p:_activate(callback, text)
		if callback then
			task.spawn(function()
				local ok, err = pcall(callback)
				if not ok then
					log.warn("Asset Viewer: popup button '" .. tostring(text) .. "' errored:")
					log.print(err)
				end
			end)
		end
		self:Close()
	end
	function p:Close()
		if self._closed then return end
		self._closed = true
		local index = table.find(popupStack, self)
		if index then table.remove(popupStack, index) end
		for _, connection in self._connections do renderer:Disconnect(connection) end
		self._connections = {}
		Dialog.hide(renderer, self)
	end

	Dialog.build(renderer, p)
	table.insert(popupStack, p)
	if p.dismissable then
		table.insert(p._connections, renderer:Connect(p.backdrop.InputBegan, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				p:Close()
			end
		end))
		table.insert(p._connections, renderer:Connect(UIS.InputBegan, function(input, processed)
			if not processed and input.KeyCode == Enum.KeyCode.Escape and popupStack[#popupStack] == p then p:Close() end
		end))
	end
	task.spawn(function() Dialog.show(p) end)
	return p
end

