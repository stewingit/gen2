function W.Destroy()
	if W.unloaded then return end
	W.unloaded = true
	alive = false
	for _, connection in renderer.connections do
		pcall(function() connection:Disconnect() end)
	end
	table.clear(renderer.connections)
	if W.screenGui then W.screenGui:Destroy() end
	if registry.Devconsole == W then registry.Devconsole = nil end
end

