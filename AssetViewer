}

local loaderLoading = false
local fileTabs, openTabs, fileCounter = {}, {}, 0 -- open file tabs, keyed by file path / asset id
local loaderBrowser
local sourceCache = setmetatable({}, {__mode = 'k'})

local function clip(text, limit)
	text = tostring(text):gsub('%c', ' ')
	local length = utf8.len(text)
	if not length then return text:sub(1, limit) end
	if length <= limit then return text end
	return text:sub(1, utf8.offset(text, limit) - 1) .. '...'
end

local function sanitize(text)
	text = tostring(text)
	if not utf8.len(text) then text = text:gsub('[\128-\255]', '?') end
	return text
end

local function nodeChildren(node)
	if typeof(node) == 'Instance' then
		local ok, kids = pcall(function() return node:GetChildren() end)
		return if ok then kids else {}
	end
	return node.Children
end

local function propValue(node, prop)
	local ok, value = pcall(function() return node[prop] end)
	if ok and type(value) == 'string' and value ~= '' then return value end
	return nil
end

local function parseAssetId(text)
	if type(text) ~= 'string' then return nil end
	local id = text:match('rbxassetid://(%d+)') or text:match('[?&]id=(%d+)') or text:match('^%s*(%d+)%s*$')
		or text:match('roblox%.com/[%w%-]+/(%d+)')
	return tonumber(id)
end

-- Returns kind, property that holds the asset reference
local function classify(node)
	if typeof(node) ~= 'Instance' then return 'file', nil end
	if node:IsA('LuaSourceContainer') then return 'script', nil end
	if node:IsA('Sound') then return 'audio', 'SoundId' end
	if node:IsA('Decal') then return 'image', 'Texture' end
	if node:IsA('ImageLabel') or node:IsA('ImageButton') then return 'image', 'Image' end
	if node:IsA('Shirt') then return 'image', 'ShirtTemplate' end
	if node:IsA('Pants') then return 'image', 'PantsTemplate' end
	if node:IsA('ShirtGraphic') then return 'image', 'Graphic' end
	if node:IsA('MeshPart') or node:IsA('FileMesh') then return 'mesh', 'MeshId' end
	if node:IsA('Animation') then return 'animation', 'AnimationId' end
	if node:IsA('VideoFrame') then return 'video', 'Video' end
	if node:IsA('Folder') then return 'folder', nil end
	return 'instance', nil
end

local function pathOf(node, rootName)
	local parts, current, guard = {}, node, 0
	while current and guard < 100 do
		table.insert(parts, 1, current.Name)
		current = current.Parent
		guard += 1
	end
	return (if rootName then rootName .. '/' else '') .. table.concat(parts, '.')
end

local function firstChars(text, count)
	text = tostring(text):gsub('%c', ' ')
	local length = utf8.len(text)
	if not length then return text:sub(1, count) end
	if length <= count then return text end
	return text:sub(1, utf8.offset(text, count + 1) - 1)
end

local function getSource(node)
	if sourceCache[node] then return sourceCache[node] end
	local source
	local ok, value = pcall(function() return node.Source end)
	if ok and type(value) == 'string' and value ~= '' then source = value end
	if not source and type(decompile) == 'function' then
		local decompiled, result = pcall(decompile, node)
		if decompiled and type(result) == 'string' and result ~= '' then source = result end
	end
	if source then sourceCache[node] = source end
	return source
end

local function sourcePreview(source)
	local out, count, chars = {}, 0, 0
	for line in (source .. '\n'):gmatch('(.-)\r?\n') do
		count += 1
		if count > 30 or chars > 1800 then break end
		line = line:sub(1, 160)
		table.insert(out, line)
		chars += #line + 1
	end
	return sanitize(table.concat(out, '\n'))
end

local function sniff(data)
	local head = data:sub(1, 16)
	if head:sub(1, 8) == '\137PNG\r\n\26\n' then return '.png', 'PNG image' end
	if head:sub(1, 3) == '\255\216\255' then return '.jpg', 'JPEG image' end
	if head:sub(1, 4) == 'OggS' then return '.ogg', 'Ogg audio' end
	if head:sub(1, 3) == 'ID3' or (head:byte(1) == 255 and (head:byte(2) or 0) >= 224) then return '.mp3', 'MP3 audio' end
	if head:sub(1, 4) == 'RIFF' and head:sub(9, 12) == 'WEBP' then return '.webp', 'WebP image' end
	if head:sub(1, 4) == 'RIFF' and head:sub(9, 12) == 'WAVE' then return '.wav', 'WAV audio' end
	if head:sub(5, 8) == 'ftyp' then return '.mp4', 'MP4 video' end
	if head:sub(1, 4) == '\26\69\223\163' then return '.webm', 'WebM video' end
	if head:sub(1, 8) == '<roblox!' then return '.rbxm', 'Roblox binary model' end
	if head:sub(1, 8) == '<roblox ' then return '.rbxmx', 'Roblox XML model' end
	if head:sub(1, 8) == 'version ' then return '.mesh', 'Roblox mesh' end
	return nil, nil
end

local function fetchAsset(id)
	local ok, res = pcall(function() return game:HttpGet('https://assetdelivery.roblox.com/v1/asset/?id=' .. id) end)
	if ok and type(res) == 'string' and #res > 100 and res:sub(1, 10) ~= '{"errors":' then return res end
	return nil
end

local function fetchThumbnail(id)
	local url = 'https://thumbnails.roblox.com/v1/assets?assetIds=' .. id .. '&returnPolicy=PlaceHolder&size=420x420&format=Png&isCircular=false'
	local ok, response = pcall(function() return game:HttpGet(url) end)
	if not ok or not response then return nil end
	local decodeOk, decoded = pcall(function() return HttpService:JSONDecode(response) end)
	local imageUrl = decodeOk and decoded and decoded.data and decoded.data[1] and decoded.data[1].imageUrl
	if not imageUrl then return nil end
	local imgOk, imgData = pcall(function() return game:HttpGet(imageUrl) end)
	if imgOk and type(imgData) == 'string' and #imgData > 100 then return imgData end
	return nil
end

local IMAGE_EXTS = {['.png'] = true, ['.jpg'] = true, ['.webp'] = true}

local function fetchImage(id)
	local data = fetchAsset(id)
	if data then
		if IMAGE_EXTS[sniff(data) or ''] then return data end
		local inner = tonumber(data:match('rbxassetid://(%d+)') or data:match('[?&]id=(%d+)'))
		if inner and inner ~= id then
			local second = fetchAsset(inner)
			if second and IMAGE_EXTS[sniff(second) or ''] then return second end
		end
	end
	return fetchThumbnail(id)
end

local function listSavedFiles()
	local available = type(listfiles) == 'function'
	local files = {}
	if available then
		local ok, list = pcall(listfiles, LOAD_FOLDER)
		if ok and type(list) == 'table' then
			for _, path in list do
				local normal = tostring(path):gsub('\\', '/')
				local ext = normal:match('%.(%w+)$')
				if ext and (ext:lower() == 'rbxm' or ext:lower() == 'rbxmx') then
					table.insert(files, {path = normal, name = normal:match('([^/]+)$') or normal})
				end
			end
		end
		table.sort(files, function(x, y) return x.name:lower() < y.name:lower() end)
	end
	return files, available
end

-- ---------------------------------------------------------------- browser (one per tab)

local browserRefresh, browserUp, browserOptions, browserRow, browserPage, closeFileTab

local function browserBusy(b, on, text)
	if on then
		b.activity:SetTitle(text or 'Working...')
		b.activity.main.Visible = true
		b.activity:SetIndeterminate(true)
	else
		b.activity:SetIndeterminate(false)
		b.activity.main.Visible = false
	end
end

local function toast(title, subtitle, icon)
	window:Toast({title = title, subtitle = subtitle, icon = icon or 'x'})
end

local function newBrowser(tab, mode)
	local isFiles = mode == 'files'
	local b = {tab = tab, mode = mode, entries = {}, pageIndex = 1, navStack = {}, node = nil, rows = {}}

	local function buildNav()
		b.navRow = Group_(tab)
		if not isFiles then
			b.upBtn = Button_(b.navRow, {name = 'Up', icon = 'arrow-up', callback = function() browserUp(b) end})
			b.optionsBtn = Button_(b.navRow, {name = 'Options', icon = 'ellipsis', callback = function() browserOptions(b) end})
			b.upBtn.main.Visible = false
			b.optionsBtn.main.Visible = false
		end
		b.refreshBtn = Button_(b.navRow, {name = 'Refresh', icon = 'refresh-cw', callback = function() browserRefresh(b, false) end})
		if not isFiles then
			b.closeBtn = Button_(b.navRow, {name = 'Close', icon = 'x', callback = function() closeFileTab(tab) end})
		end
	end

	if not isFiles then buildNav() end
	b.activity = Progress_(tab, {name = 'Working...', showValue = false})
	b.activity.main.Visible = false
	b.info = Text_(tab, {
		name = if isFiles then 'Loader' else esc(tab.fullName),
		icon = if isFiles then 'folder-open' else 'file-box',
		text = 'Loading...',
	})
	if isFiles then buildNav() end

	for index = 1, PAGE_SIZE do
		local row = Button_(tab, {name = ' ', icon = 'file', callback = function() browserRow(b, index) end})
		row.main.Visible = false
		row.main.ClipsDescendants = true
		b.rows[index] = row
	end

	b.pagerRow = Group_(tab)
	Button_(b.pagerRow, {name = 'Previous', icon = 'chevron-left', callback = function() browserPage(b, -1) end})
	Button_(b.pagerRow, {name = 'Next', icon = 'chevron-right', callback = function() browserPage(b, 1) end})
	b.pagerRow.main.Visible = false

	tab.browser = b
	return b
end

local function updateBrowserInfo(b, pages)
	local pageLine = if pages > 1 then string.format('\n<b>Page</b>  %d / %d', b.pageIndex, pages) else ''
	if b.mode == 'files' then
		local _, available = listSavedFiles()
		b.info:SetTitle('Loader files')
		if not available then
			b.info:Set('Your executor has no listfiles, so the files in the Loader folder cannot be listed.')
		else
			b.info:Set(string.format('<b>Folder</b>  %s\n<b>Files</b>  %d%s\nTap a file to open it in its own tab.',
				esc(LOAD_FOLDER), #b.entries, pageLine))
		end
	else
		local file = b.tab.file
		b.info:SetTitle(esc(b.node.Name))
		local pathLine = if b.node == file then esc(file.Path or file.Name) else esc(pathOf(b.node, file.Name))
		b.info:Set(string.format('<b>Class</b>  %s\n<b>Items</b>  %d%s\n<b>Path</b>  %s',
			esc(b.node.ClassName), #b.entries, pageLine, pathLine))
	end
end

browserRefresh = function(b, scrollTop)
	local entries = {}
	if b.mode == 'files' then
		for _, file in listSavedFiles() do
			table.insert(entries, {kind = 'file', path = file.path, name = file.name})
		end
	else
		for _, child in nodeChildren(b.node) do
			table.insert(entries, {kind = 'node', node = child})
		end
	end
	b.entries = entries

	local pages = math.max(1, math.ceil(#entries / PAGE_SIZE))
	b.pageIndex = math.clamp(b.pageIndex, 1, pages)

	for index = 1, PAGE_SIZE do
		local row = b.rows[index]
		local entry = entries[(b.pageIndex - 1) * PAGE_SIZE + index]
		if entry then
			local label, icon
			if entry.kind == 'file' then
				label, icon = clip(entry.name, 40), KIND_ICONS.file
			else
				local node = entry.node
				entry.kids = entry.kids or #nodeChildren(node)
				label = clip(node.Name, 22) .. '  \u{2022}  ' .. clip(node.ClassName, 18)
				if entry.kids > 0 then label ..= string.format('  (%d)', entry.kids) end
				icon = KIND_ICONS[(classify(node))] or KIND_ICONS.instance
			end
			row:SetText(label)
			row:SetIcon(icon)
			row.main.Visible = true
		else
			row.main.Visible = false
		end
	end

	if b.mode == 'nodes' then
		local inTree = #b.navStack > 1
		b.upBtn.main.Visible = inTree
		b.optionsBtn.main.Visible = inTree
		b.refreshBtn.main.Visible = not inTree
		b.closeBtn.main.Visible = not inTree
	end
	b.pagerRow.main.Visible = pages > 1
	updateBrowserInfo(b, pages)
	if scrollTop and b.tab.tabPage then b.tab.tabPage.CanvasPosition = Vector2.zero end
end

browserPage = function(b, delta)
	local pages = math.max(1, math.ceil(#b.entries / PAGE_SIZE))
	local target = math.clamp(b.pageIndex + delta, 1, pages)
	if target == b.pageIndex then return end
	b.pageIndex = target
	browserRefresh(b, true)
end

browserUp = function(b)
	if #b.navStack <= 1 then return end
	table.remove(b.navStack)
	b.node = b.navStack[#b.navStack]
	b.pageIndex = 1
	browserRefresh(b, true)
end

browserOptions = function(b)
	if typeof(b.node) == 'Instance' then window:NodeMenu(b.node, b) end
end

browserRow = function(b, index)
	local entry = b.entries[(b.pageIndex - 1) * PAGE_SIZE + index]
	if not entry then return end
	if entry.kind == 'file' then
		window:Load(entry.path)
	elseif (entry.kids or 0) > 0 then
		table.insert(b.navStack, entry.node)
		b.node = entry.node
		b.pageIndex = 1
		browserRefresh(b, true)
	else
		window:NodeMenu(entry.node, b)
	end
end

