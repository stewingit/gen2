N['Engine/Core/StyleRegistry'] = Runtime.module(N['Engine/Core'], 'StyleRegistry', function(script, require)
local StyleRegistry = {}
local folder = script.Parent.Parent.Styles
local defined = {}
local api = {define = true, get = true, has = true}

function StyleRegistry.define(name, definition)
	assert(type(name) == "string" and not api[name], "invalid style name")
	assert(defined[name] == nil and folder:FindFirstChild(name) == nil, "style '" .. name .. "' already exists")
	defined[name] = definition
	return definition
end

function StyleRegistry.has(name)
	return defined[name] ~= nil or folder:FindFirstChild(name) ~= nil
end

function StyleRegistry.get(name)
	local definition = defined[name]
	if definition ~= nil then return definition end
	local module = folder:FindFirstChild(name)
	assert(module, "unknown style '" .. tostring(name) .. "'")
	definition = require(module)
	defined[name] = definition
	return definition
end

return setmetatable(StyleRegistry, {
	__index = function(_, name)
		if api[name] or not StyleRegistry.has(name) then return nil end
		return StyleRegistry.get(name)
	end,
})

end)
