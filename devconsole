local function collapsedRect()
	local size = if W.showIconOnly then UDim2.fromOffset(50, 50) else COLLAPSED_SIZE
	if W._collapsedPosition then return W._collapsedPosition, size end
	return UDim2.new(COLLAPSED_POSITION.X.Scale, COLLAPSED_POSITION.X.Offset, COLLAPSED_POSITION.Y.Scale, COLLAPSED_POSITION.Y.Offset + size.Y.Offset / 2), size
end

function W.Hide()
	if W.animating or W.hidden then return end
	W.animating = true
	W.hidden = true
	W.collapsedInteract.Visible = false
	W._restorePosition = W.main.Position
	local position, size = collapsedRect()
	local fast, move, corner, face = presets.Quint_0_18, presets.ExpoInOut_0_35, presets.ExpoInOut_0_35, presets.Quint_0_2
	Animator.play(dragBar.dragCosmetic, fast, {Size = UDim2.fromOffset(0, 4), BackgroundTransparency = 1})
	task.delay(0.18, function()
		if W.hidden then dragBar.drag.Visible = false end
	end)
	fadeSurfaces(false, fast)
	fadeTopbar(false, fast)
	revealElements(false, true)
	local tween = Animator.play(W.main, move, {Size = size, Position = position})
	tween.Completed:Connect(function()
		if W.unloaded or not W.hidden then return end
		W._collapsedShown = true
		W.collapsedInteract.Visible = true
		W.animating = false
	end)
	Animator.play(W.windowCorner, corner, {CornerRadius = UDim.new(1, 0)})
	task.delay(0.18, function()
		if not W.hidden then return end
		W.topbar.Visible = false
		setContentVisible(false)
		CollapsedFace.setShown(W, true, face)
	end)
end

local function restore()
	local position = clampedPosition(W._restorePosition or UDim2.new(0.5, 0, 0.5, 0))
	W._restorePosition = position
	local move, corner, fade = presets.ExpoInOut_0_35, presets.ExpoInOut_0_35, presets.Expo_0_28
	CollapsedFace.setShown(W, false, presets.Quint_0_15)
	local tween = Animator.play(W.main, move, {Size = SIZE, Position = position})
	tween.Completed:Connect(function()
		if W.hidden or W.unloaded then return end
		W._collapsedShown = false
	end)
	Animator.play(W.windowCorner, corner, {CornerRadius = theme.CornerRoundness})
	task.delay(0.22, function()
		if W.hidden or W.unloaded then return end
		W.topbar.Visible = true
		setContentVisible(true)
		fadeSurfaces(true, fade)
		fadeTopbar(true, fade)
		task.spawn(revealElements, true, true, 0.03)
	end)
	task.delay(0.22, function()
		if W.hidden or W.unloaded then return end
		syncDragBar()
		dragBar.dragCosmetic.Size = UDim2.fromOffset(0, 4)
		dragBar.dragCosmetic.BackgroundTransparency = 1
		dragBar.drag.Visible = true
		Animator.play(dragBar.dragCosmetic, move, {Size = UDim2.fromOffset(100, 4), BackgroundTransparency = 0.7})
	end)
	task.delay(0.6, function() W.animating = false end)
end

local function firstShow()
	setContentVisible(true)
	W.main.Visible = true
	Animator.play(W.main, presets.ExpoInOut_1, {BackgroundTransparency = 0, Size = SIZE})
	task.wait(0.85)
	if W.unloaded then return end
	fadeSurfaces(true, presets.Expo_0_6)
	task.wait(0.3)
	if W.unloaded then return end
	fadeTopbar(true, presets.Expo_0_4)
	task.wait(0.1)
	task.spawn(revealElements, true, true, 0.03)
	task.wait(1)
	if W.unloaded then return end
	syncDragBar()
	dragBar.drag.Visible = true
	Animator.play(dragBar.dragCosmetic, presets.Expo_0_6, {BackgroundTransparency = 0.7})
	Animator.play(dragBar.dragCosmetic, presets.Expo_1, {Size = UDim2.fromOffset(100, 4)})
	W.animating = false
end

function W.Show()
	if W.animating or not W.hidden then return end
	W.animating = true
	W.hidden = false
	W.collapsedInteract.Visible = false
	if W._hasShownOnce then restore() else W._hasShownOnce = true firstShow() end
end

function W.ToggleHide()
	if W.animating then return end
	if W.hidden then W.Show() else W.Hide() end
end

